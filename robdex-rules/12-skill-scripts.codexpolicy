# Allow executable skill entrypoints to run through the privileged executor.
# This keeps the shared agent tool surface off the sandbox path.

prefix_rule(
    pattern = ["npm", "run", "bun:shot"],
    decision = "allow",
)
prefix_rule(
    pattern = ["npm", "install"],
    decision = "allow",
)
prefix_rule(
    pattern = ["docker"],
    decision = "allow",
)
prefix_rule(
    pattern = [[
        "designer-crop-screenshot", "/Users/robertsale/.codex/skills/designer-runtime/scripts/designer-crop-screenshot",
        "designer-drive", "/Users/robertsale/.codex/skills/designer-runtime/scripts/designer-drive",
        "designer-flutter-run", "/Users/robertsale/.codex/skills/designer-runtime/scripts/designer-flutter-run",
        "designer-hot-reload", "/Users/robertsale/.codex/skills/designer-runtime/scripts/designer-hot-reload",
        "design-lab-capture",
        "design-review", "/Users/robertsale/.codex/skills/design-worker/scripts/design-review",
        "api-integration-harness",
        "api_integration_reaper",
        "api_integration_reaper_start",
        "flutter-drive", "/Users/robertsale/.codex/skills/flutter-driver-cli/scripts/flutter-drive",
        # Legacy compatibility only: flutter-sim reserve/reboot emit deprecation guidance.
        "flutter-sim", "/Users/robertsale/.codex/skills/flutter-driver-cli/scripts/flutter-sim",
        "impeccable-ui-dispatch", "/Users/robertsale/.codex/skills/impeccable-ui/scripts/impeccable-ui-dispatch",
        "manual-deploy",
        "public-dev-tunnel", "/Users/robertsale/.codex/skills/privileged-exec/scripts/public-dev-tunnel",
        "release-blocker-report",
        "robdex", "/Users/robertsale/.codex/skills/robdex-orchestrator/scripts/robdex",
        "safe-delete", "/Users/robertsale/.codex/skills/safe-delete/scripts/safe-delete",
        "static-code-validation",
        "worktree-stack-role-instructions", "designer-crop-screenshot", "designer-drive", "designer-flutter-run", "designer-hot-reload",
        "api-integration-harness", "git-recover-published-worktree", "git-rebase-continue",
    ]],
    decision = "allow",
)
