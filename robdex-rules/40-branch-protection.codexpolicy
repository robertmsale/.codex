# Branch safety protections.
prefix_rule(
    pattern = ["git", "push", "origin", ["main", "master", "staging", "develop", "production"]],
    decision = "forbidden",
    justification = "Use only sanctioned gitops scripts.",
)
prefix_rule(
    pattern = ["git", "push", ["-f", "--force"]],
    decision = "forbidden",
    justification = "Force pushes are only allowed in sanctioned gitops scripts.",
)
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
)
