#!/usr/bin/env bash
set -euo pipefail

SESSION="${1:-robdex-design-lab}"
PORT="${ROBDEX_DESIGN_LAB_PORT:-43110}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LAB_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "design lab already running in tmux session: $SESSION"
  echo "url: http://127.0.0.1:$PORT"
  exit 0
fi

tmux new-session -d -s "$SESSION" -c "$LAB_DIR" \
  "flutter run -d web-server --web-hostname 127.0.0.1 --web-port $PORT"

echo "started design lab tmux session: $SESSION"
echo "url: http://127.0.0.1:$PORT"
