#!/usr/bin/env bash
set -euo pipefail

show_usage() {
  cat >&2 <<'EOF_USAGE'
Usage:
  command-parser [--request-additional "<analysis request>"] [--warnings] <command...>

Notes:
  - Runs the command directly on host.
  - Captures command output locally.
  - Sends the captured output to the local codex-aux-http server for extraction.
EOF_USAGE
}

check_command_policy() {
  local rule_file="$1"
  shift

  if [[ ! -f "$rule_file" ]]; then
    return 0
  fi

  local check_output
  if ! check_output="$(codex execpolicy check --rules "$rule_file" -- "$@" 2>&1)"; then
    echo "command-parser: execpolicy check failed for $rule_file: $check_output" >&2
    exit 1
  fi

  local status=0
  python3 - "$check_output" <<'PY' || status=$?
import json
import sys

raw = sys.argv[1].strip()
if not raw:
    raise SystemExit(0)

decoder = json.JSONDecoder()
payload = None
for index, char in enumerate(raw):
    if char != "{":
        continue
    try:
        candidate, _ = decoder.raw_decode(raw[index:])
    except json.JSONDecodeError:
        continue
    if isinstance(candidate, dict):
        payload = candidate
        break

if payload is None:
    print(f"command-parser: execpolicy output was not valid JSON: {raw}", file=sys.stderr)
    raise SystemExit(1)

decision = str(payload.get("decision", "")).strip().lower()
matched_rules = payload.get("matchedRules") or []

forbidden_message = None
for entry in matched_rules:
    if not isinstance(entry, dict):
        continue
    prefix_match = entry.get("prefixRuleMatch")
    if not isinstance(prefix_match, dict):
        continue
    rule_decision = str(prefix_match.get("decision", "")).strip().lower()
    justification = str(prefix_match.get("justification", "")).strip()
    if rule_decision == "forbidden":
        forbidden_message = justification or "Command is forbidden by command-parser.rule."
        break

if forbidden_message:
    print(f"Command blocked by command-parser.rule: {forbidden_message}")
    raise SystemExit(2)

if decision == "prompt":
    print(
        "command-parser encountered a command that would require approval. "
        "Treat this as a real sandbox/tooling bug: report the failing invocation to the orchestrator so writable roots or workflow can be fixed.",
        file=sys.stderr,
    )
    raise SystemExit(3)
PY

  case "$status" in
    0) ;;
    2) exit 2 ;;
    3) exit 3 ;;
    *) exit "$status" ;;
  esac
}

additional_request="${COMMAND_PARSER_ADDITIONAL_REQUEST:-}"
include_warnings="no"
if [[ "${COMMAND_PARSER_WARNINGS:-0}" != "0" && "${COMMAND_PARSER_WARNINGS:-}" != "" ]]; then
  include_warnings="yes"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --request-additional|--request-info)
      if [[ $# -lt 2 ]]; then
        echo "command-parser: missing value for $1" >&2
        show_usage
        exit 2
      fi
      additional_request="$2"
      shift 2
      ;;
    --warnings)
      include_warnings="yes"
      shift
      ;;
    --help|-h)
      show_usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "command-parser: unknown option: $1" >&2
      show_usage
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  show_usage
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
env_file="${COMMAND_PARSER_ENV_FILE:-$script_dir/command-parser.env}"
rule_file="${COMMAND_PARSER_RULE_FILE:-$script_dir/command-parser.rule}"
if [[ -f "$env_file" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a
fi

export CODEX_DISABLE_AUTO_COMMAND_PARSER=1
export CODEX_COMMAND_PARSER_ACTIVE=1
export IS_USING_COMMAND_PARSER=true

check_command_policy "$rule_file" "$@"

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "command-parser: missing required command: $1" >&2
    exit 1
  }
}

require_cmd curl
require_cmd python3

profile="${COMMAND_PARSER_PROFILE:-command-parser}"
aux_base_url="${CODEX_AUX_SERVER_BASE_URL:-http://127.0.0.1:8771}"
tmp_root="${TMPDIR:-/tmp}"
tmp_dir="$(mktemp -d "${tmp_root%/}/command-parser.XXXXXX")"
cleanup() {
  rm -rf "$tmp_dir" >/dev/null 2>&1 || true
}
trap cleanup EXIT

if CODEX_DISABLE_AUTO_COMMAND_PARSER=1 IS_USING_COMMAND_PARSER=true CODEX_COMMAND_PARSER_ACTIVE=1 "$@" >"$tmp_dir/output.log" 2>&1; then
  :
fi

python3 - "$tmp_dir/request.json" "$profile" "$include_warnings" "$additional_request" "$tmp_dir/output.log" "$@" <<'PY'
import json
import pathlib
import sys

request_path = pathlib.Path(sys.argv[1])
profile = sys.argv[2]
include_warnings = sys.argv[3] == "yes"
additional_request = sys.argv[4] or None
output_path = pathlib.Path(sys.argv[5])
command = sys.argv[6:]

payload = {
    "command": command,
    "output": output_path.read_text(encoding="utf-8", errors="replace"),
    "includeWarnings": include_warnings,
    "additionalRequest": additional_request,
    "profile": profile,
}
request_path.write_text(json.dumps(payload), encoding="utf-8")
PY

response="$(
  curl -fsS \
    -H 'Content-Type: application/json' \
    --data @"$tmp_dir/request.json" \
    "$aux_base_url/v1/command-parser/parse"
)"

response_file="$tmp_dir/response.json"
printf '%s' "$response" >"$response_file"

python3 - "$response_file" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    data = json.load(fh)
if not data.get("ok"):
    message = (data.get("error") or "command-parser server request failed").strip()
    print(f"command-parser: {message}", file=sys.stderr)
    raise SystemExit(1)
print((data.get("message") or "").rstrip())
PY
