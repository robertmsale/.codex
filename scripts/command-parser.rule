# ------------------------------------------
# Low-noise commands: refuse command-parser use
# ------------------------------------------
prefix_rule(
    pattern = [[
        "ls",
        "dir",
        "pwd",
        "cd",
        "tree",
        "find",
        "fd",
        "fdfind",
        "locate",
        "which",
        "whereis",
        "realpath",
        "readlink",
        "basename",
        "dirname",
        "file",
        "stat",
        "du",
        "df",
        "rg",
        "grep",
        "egrep",
        "fgrep",
        "ag",
        "ack",
        "git",
        "cat",
        "head",
        "tail",
        "sed",
        "awk",
        "wc",
        "sort",
        "uniq",
        "cut",
        "xargs",
        "ps",
        "top",
        "htop",
        "pgrep",
        "pstree",
        "printenv",
        "flutter-sim",
        "flutter-driver",
        "git-commit",
        "git-merge-worktree",
        "git-publish-worktree",
        "git-rebase-abort",
        "git-rebase-continue",
        "git-recover-published-worktree",
        "git-stage-paths",
        "git-sync-worktree",
        "git-unstage-paths",
        "git-worktree-cleanup",
        "git-worktree-create",
        "qa-fastforward",
        "robdex",
        "safe-delete",
        "request-review",
    ]],
    decision = "forbidden",
    justification = "run directly.",
)
