# command-parser.rule
# Evaluated by command-parser MCP before sandbox/execution:
#   codex execpolicy check --rules <this-file> -- <raw-command...>
#
# This ruleset blocks:
# 1) Code formatters entirely.
# 2) Low-noise commands that should run directly instead of command-parser.

# --------------------
# Formatters (hard ban)
# --------------------
prefix_rule(
    pattern = ["cargo", ["fmt"]],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["rustfmt"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["npx", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["pnpm", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["pnpm", "exec", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["yarn", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = ["npm", "exec", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
