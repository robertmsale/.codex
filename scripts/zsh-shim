#!/usr/bin/env bash
set -euo pipefail

REAL_ZSH="/bin/zsh"
PRIVILEGED_EXEC_BASE_URL="${CODEX_PRIVILEGED_EXEC_BASE_URL:-http://127.0.0.1:8776}"

internal_shim_curl() {
  env CODEX_SHIM_INTERNAL=1 curl "$@"
}

privileged_shell_build_request() {
  python3 - "$@" <<'PY'
import json
import os
import sys

cwd = os.getcwd()
command = sys.argv[1:]
payload = {
    "command": command,
    "cwd": cwd,
    "callerEnv": dict(os.environ),
    "envOverrides": {},
}
print(json.dumps(payload, separators=(",", ":")))
PY
}

privileged_shell_parse_check() {
  python3 -c "import json, sys; data = json.loads(sys.stdin.read()); print(f\"eligible={'1' if data.get('eligible') else '0'}\"); print(f\"decision={data.get('decision') or ''}\"); print(f\"classification={data.get('classification') or ''}\"); print(f\"reason={data.get('reason') or ''}\")"
}

privileged_shell_parse_run() {
  local stdout_file="$1"
  local stderr_file="$2"
  python3 - "$stdout_file" "$stderr_file" <<'PY'
import json
import sys

stdout_path, stderr_path = sys.argv[1:3]
data = json.loads(sys.stdin.read())
with open(stdout_path, "w", encoding="utf-8") as fh:
    fh.write(data.get("stdout") or "")
with open(stderr_path, "w", encoding="utf-8") as fh:
    fh.write(data.get("stderr") or "")
print(f"status={data.get('status') or ''}")
print(f"decision={data.get('decision') or ''}")
print(f"exit_code={'' if data.get('exitCode') is None else data.get('exitCode')}")
print(f"timed_out={'1' if data.get('timedOut') else '0'}")
print(f"reason={data.get('reason') or ''}")
PY
}

maybe_handle_policy_shell_command() {
  local mode="$1"
  local command_text="$2"
  shift 2
  local command=("$REAL_ZSH" "$mode" "$command_text" "$@")
  local request_payload=""
  local check_response=""
  local check_meta=""
  local eligible="0"
  local decision=""
  local reason=""

  command -v curl >/dev/null 2>&1 || return 1
  command -v python3 >/dev/null 2>&1 || return 1

  request_payload="$(privileged_shell_build_request "${command[@]}")"
  check_response="$(internal_shim_curl -fsS \
    -H 'Content-Type: application/json' \
    -X POST \
    "${PRIVILEGED_EXEC_BASE_URL%/}/policy/check" \
    -d "$request_payload" 2>/dev/null || true)"

  [[ -n "$check_response" ]] || return 1

  check_meta="$(privileged_shell_parse_check <<<"$check_response" 2>/dev/null || true)"
  while IFS='=' read -r key value; do
    case "$key" in
      eligible) eligible="$value" ;;
      decision) decision="$value" ;;
      reason) reason="$value" ;;
    esac
  done <<<"$check_meta"

  case "$decision" in
    forbidden|prompt)
      printf 'command blocked: %s\n' "${reason:-policy decision is ${decision}}" >&2
      exit 126
      ;;
  esac

  [[ "$eligible" == "1" ]] || return 1

  local stdout_file=""
  local stderr_file=""
  local run_response=""
  local run_meta=""
  local status=""
  local exit_code=""
  local timed_out="0"

  stdout_file="$(mktemp "${TMPDIR:-/tmp}/privileged-zsh-stdout.XXXXXX")"
  stderr_file="$(mktemp "${TMPDIR:-/tmp}/privileged-zsh-stderr.XXXXXX")"

  run_response="$(internal_shim_curl -fsS \
    -H 'Content-Type: application/json' \
    -X POST \
    "${PRIVILEGED_EXEC_BASE_URL%/}/exec/run" \
    -d "$request_payload" 2>/dev/null || true)"
  [[ -n "$run_response" ]] || {
    rm -f "$stdout_file" "$stderr_file"
    return 1
  }

  run_meta="$(privileged_shell_parse_run "$stdout_file" "$stderr_file" <<<"$run_response" 2>/dev/null || true)"
  while IFS='=' read -r key value; do
    case "$key" in
      status) status="$value" ;;
      decision) decision="$value" ;;
      exit_code) exit_code="$value" ;;
      timed_out) timed_out="$value" ;;
      reason) reason="$value" ;;
    esac
  done <<<"$run_meta"

  if [[ "$status" == "rejected" ]]; then
    rm -f "$stdout_file" "$stderr_file"
    case "$decision" in
      forbidden|prompt)
        printf 'command blocked: %s\n' "${reason:-policy decision is ${decision}}" >&2
        exit 126
        ;;
    esac
    return 1
  fi

  [[ -s "$stdout_file" ]] && cat "$stdout_file"
  [[ -s "$stderr_file" ]] && cat "$stderr_file" >&2
  rm -f "$stdout_file" "$stderr_file"

  if [[ "$timed_out" == "1" ]]; then
    exit 124
  fi
  if [[ -n "$exit_code" ]]; then
    exit "$exit_code"
  fi
  exit 1
}

if [[ $# -ge 2 && ( "${1:-}" == "-c" || "${1:-}" == "-lc" ) ]]; then
  mode="$1"
  shift
  command_text="$1"
  shift
  maybe_handle_policy_shell_command "$mode" "$command_text" "$@" || exec "$REAL_ZSH" "$mode" "$command_text" "$@"
fi

exec "$REAL_ZSH" "$@"
