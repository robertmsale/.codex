#!/bin/zsh
set -euo pipefail

show_usage() {
  cat <<'EOF'
Usage:
  flutterq <flutter-command...>

Examples:
  flutterq analyze
  flutterq test test/widget_test.dart
  flutterq run -d macos
  flutterq build macos
  flutterq pub get
  flutterq devices

Notes:
  - Injects low-noise Flutter flags by default.
  - Uses machine output for analyze/test where supported.
  - Build command output is left to the outer command wrapper.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "flutterq: missing required command: $1" >&2
    exit 1
  }
}

deny_command() {
  local command_name="$1"
  echo "flutterq: forbidden command: $command_name" >&2
  exit 2
}

contains_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

contains_prefix_arg() {
  local prefix="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$prefix"* ]]; then
      return 0
    fi
  done
  return 1
}

append_if_missing() {
  local needle="$1"
  shift
  local -n target_ref="$1"
  shift
  if ! contains_arg "$needle" "${target_ref[@]}"; then
    target_ref+=("$needle")
  fi
}

append_if_absent_by_prefix() {
  local prefix="$1"
  shift
  local -n target_ref="$1"
  shift
  if ! contains_prefix_arg "$prefix" "${target_ref[@]}"; then
    target_ref+=("$prefix")
  fi
}

remove_all_args() {
  local needle="$1"
  shift
  local target_name="$1"
  shift
  local -a filtered=()
  local arg
  local -a current=("${(@P)target_name}")
  for arg in "${current[@]}"; do
    [[ "$arg" == "$needle" ]] && continue
    filtered+=("$arg")
  done
  eval "$target_name=(\"\${filtered[@]}\")"
}

run_build_command() {
  local -a build_cmd=("$@")
  exec "${build_cmd[@]}"
}

run_devices_command() {
  local -a devices_cmd=("$@")
  local output
  local cmd_status=0

  output="$("${devices_cmd[@]}" 2>&1)" || cmd_status=$?

  if [[ "$cmd_status" -ne 0 ]]; then
    printf '%s\n' "$output"
    return "$cmd_status"
  fi

  python3 - <<'PY' "$output"
import sys

raw = sys.argv[1]
lines = raw.splitlines()

header_index = None
for i, line in enumerate(lines):
    if line.startswith("Found ") and " connected devices" in line:
        header_index = i
        break

if header_index is None:
    print(raw.rstrip())
    raise SystemExit(0)

selected = [lines[header_index]]
for line in lines[header_index + 1:]:
    if line.startswith("Error:"):
        break
    if line.startswith('Run "flutter emulators"') or line.startswith('If you expected another device'):
        break
    selected.append(line)

print("\n".join(selected).rstrip())
PY
}

run_test_command() {
  local -a test_cmd=("$@")
  local output
  local cmd_status=0

  output="$("${test_cmd[@]}" 2>&1)" || cmd_status=$?

  printf '%s' "$output" | python3 "$HOME/.codex/scripts/lib/filter_flutter_test_output.py" "$cmd_status"
}

run_analyze_command() {
  local -a analyze_cmd=("$@")
  local output
  local cmd_status=0

  output="$("${analyze_cmd[@]}" 2>&1)" || cmd_status=$?
  printf '%s' "$output" | python3 "$HOME/.codex/scripts/filter_dart_analyze_output.py"
  return "$cmd_status"
}

if [[ $# -eq 0 ]]; then
  show_usage >&2
  exit 2
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  show_usage
  exit 0
fi

require_cmd flutter

if [[ "$1" == "help" ]] || contains_arg "--help" "$@" || contains_arg "-h" "$@"; then
  exec flutter "$@"
fi

base_args=(
  "--suppress-analytics"
  "--no-version-check"
  "--quiet"
  "--no-color"
  "--no-wrap"
)

args=("$@")
command="$1"
subcommand="${2:-}"

if ! contains_arg "--suppress-analytics" "${args[@]}"; then
  args=("${base_args[@]}" "${args[@]}")
fi

case "$command" in
  format)
    deny_command "format"
    ;;
  analyze)
    if ! contains_arg "--machine" "${args[@]}"; then
      args+=("--machine")
    fi
    if ! contains_arg "--congratulate" "${args[@]}" && ! contains_arg "--no-congratulate" "${args[@]}"; then
      args+=("--no-congratulate")
    fi
    if ! contains_arg "--preamble" "${args[@]}" && ! contains_arg "--no-preamble" "${args[@]}"; then
      args+=("--no-preamble")
    fi
    if ! contains_arg "--suggestions" "${args[@]}" && ! contains_arg "--no-suggestions" "${args[@]}"; then
      args+=("--no-suggestions")
    fi
    remove_all_args "--fatal-infos" args
    if ! contains_arg "--no-fatal-infos" "${args[@]}"; then
      args+=("--no-fatal-infos")
    fi
    run_analyze_command flutter "${args[@]}"
    ;;
  test)
    if ! contains_arg "--machine" "${args[@]}"; then
      args+=("--machine")
    fi
    if ! contains_arg "--fail-fast" "${args[@]}" && ! contains_arg "--no-fail-fast" "${args[@]}"; then
      args+=("--fail-fast")
    fi
    run_test_command flutter "${args[@]}"
    ;;
  emulators)
    exec flutter "${args[@]}"
    ;;
  run)
    if [[ "${ROBDEX_DESIGNER_FLUTTER_RUN:-}" == "1" ]]; then
      exec flutter "${args[@]}"
    fi
    deny_command "run"
    ;;
  devices)
    if ! contains_arg "--device-connection" "${args[@]}"; then
      args+=("--device-connection" "attached")
    fi
    if ! contains_prefix_arg "--device-timeout" "${args[@]}"; then
      args+=("--device-timeout" "5")
    fi
    run_devices_command flutter "${args[@]}"
    ;;
  emulators)
    exec flutter "${args[@]}"
    ;;
  pub)
    exec flutter "${args[@]}"
    ;;
  build)
    if [[ -z "$subcommand" ]]; then
      echo "flutterq: missing build subcommand" >&2
      exit 2
    fi
    run_build_command flutter "${args[@]}"
    ;;
  *)
    exec flutter "${args[@]}"
    ;;
esac
