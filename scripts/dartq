#!/bin/zsh
set -euo pipefail

source "$HOME/.codex/scripts/common.sh"
source "$HOME/.codex/scripts/privileged_exec.sh"

DARTQ_REAL_PATH="$(unshim_current_path)"

show_usage() {
  cat <<'EOF'
Usage:
  dartq <dart-command...>

Examples:
  dartq run bin/tool.dart
  dartq test
  dartq compile exe bin/tool.dart -o bin/tool
  dartq pub outdated
  dartq pub deps

Notes:
  - Injects low-noise Dart flags by default.
  - Compile command output is left to the outer command wrapper.
  - Prefers machine-readable output for pub outdated.
EOF
}

require_cmd() {
  PATH="$DARTQ_REAL_PATH" command -v "$1" >/dev/null 2>&1 || {
    echo "dartq: missing required command: $1" >&2
    exit 1
  }
}

deny_command() {
  local command_name="$1"
  if [[ "$command_name" == "format" ]]; then
    echo "dartq: HARD DENY: code formatters are absolutely forbidden on this machine. Do not run dart format." >&2
  else
    echo "dartq: forbidden command: $command_name" >&2
  fi
  exit 2
}

contains_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

contains_prefix_arg() {
  local prefix="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$prefix"* ]]; then
      return 0
    fi
  done
  return 1
}

remove_all_args() {
  local needle="$1"
  shift
  local target_name="$1"
  shift
  local -a filtered=()
  local arg
  local -a current=("${(@P)target_name}")
  for arg in "${current[@]}"; do
    [[ "$arg" == "$needle" ]] && continue
    filtered+=("$arg")
  done
  eval "$target_name=(\"\${filtered[@]}\")"
}

run_compile_command() {
  local -a compile_cmd=("$@")
  run_passthrough_command "${compile_cmd[@]}"
}

privileged_cleanup_files() {
  rm -f "${PRIVILEGED_EXEC_STDOUT_FILE:-}" "${PRIVILEGED_EXEC_STDERR_FILE:-}"
}

run_passthrough_command() {
  PATH="$DARTQ_REAL_PATH" run_via_privileged_exec_if_allowed "$@"
  case "$PRIVILEGED_EXEC_OUTCOME" in
    handled)
      [[ -f "$PRIVILEGED_EXEC_STDOUT_FILE" ]] && cat "$PRIVILEGED_EXEC_STDOUT_FILE"
      [[ -f "$PRIVILEGED_EXEC_STDERR_FILE" ]] && cat "$PRIVILEGED_EXEC_STDERR_FILE" >&2
      local exit_status="$PRIVILEGED_EXEC_STATUS"
      privileged_cleanup_files
      exit "$exit_status"
      ;;
    reject)
      exit "$PRIVILEGED_EXEC_STATUS"
      ;;
  esac
  PATH="$DARTQ_REAL_PATH" exec "$@"
}

capture_command_output() {
  PATH="$DARTQ_REAL_PATH" run_via_privileged_exec_if_allowed "$@"
  case "$PRIVILEGED_EXEC_OUTCOME" in
    handled)
      [[ -f "$PRIVILEGED_EXEC_STDOUT_FILE" ]] && cat "$PRIVILEGED_EXEC_STDOUT_FILE"
      [[ -f "$PRIVILEGED_EXEC_STDERR_FILE" ]] && cat "$PRIVILEGED_EXEC_STDERR_FILE"
      local exit_status="$PRIVILEGED_EXEC_STATUS"
      privileged_cleanup_files
      return "$exit_status"
      ;;
    reject)
      return "$PRIVILEGED_EXEC_STATUS"
      ;;
  esac
  PATH="$DARTQ_REAL_PATH" "$@" 2>&1
}

run_analyze_command() {
  local -a analyze_cmd=("$@")
  local output
  local cmd_status=0

  output="$(capture_command_output "${analyze_cmd[@]}")" || cmd_status=$?
  printf '%s' "$output" | python3 "$HOME/.codex/scripts/filter_dart_analyze_output.py"
  return "$cmd_status"
}

if [[ $# -eq 0 ]]; then
  show_usage >&2
  exit 2
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  show_usage
  exit 0
fi

require_cmd dart

if [[ "$1" == "help" ]] || contains_arg "--help" "$@" || contains_arg "-h" "$@"; then
  run_passthrough_command dart "$@"
fi

base_args=(
  "--suppress-analytics"
)

args=("$@")
command="$1"
subcommand="${2:-}"

if ! contains_arg "--suppress-analytics" "${args[@]}"; then
  args=("${base_args[@]}" "${args[@]}")
fi

case "$command" in
  format)
    deny_command "format"
    ;;
  run)
    run_passthrough_command dart "${args[@]}"
    ;;
  analyze)
    remove_all_args "--fatal-infos" args
    if ! contains_arg "--no-fatal-infos" "${args[@]}"; then
      args+=("--no-fatal-infos")
    fi
    run_analyze_command dart "${args[@]}"
    ;;
  test)
    run_passthrough_command dart "${args[@]}"
    ;;
  compile)
    if [[ -n "$subcommand" ]] && ! contains_prefix_arg "--verbosity" "${args[@]}"; then
      args=("${args[@]:0:3}" "--verbosity=warning" "${args[@]:3}")
    fi
    run_compile_command dart "${args[@]}"
    ;;
  pub)
    case "$subcommand" in
      outdated)
        if ! contains_arg "--json" "${args[@]}"; then
          args+=("--json")
        fi
        run_passthrough_command dart "${args[@]}"
        ;;
      deps|get|upgrade|workspace|add|remove|bump|unpack)
        if ! contains_arg "--no-color" "${args[@]}" && ! contains_arg "--color" "${args[@]}"; then
          args=("${args[@]:0:2}" "--no-color" "${args[@]:2}")
        fi
        run_passthrough_command dart "${args[@]}"
        ;;
      *)
        run_passthrough_command dart "${args[@]}"
        ;;
    esac
    ;;
  info|installed)
    run_passthrough_command dart "${args[@]}"
    ;;
  *)
    run_passthrough_command dart "${args[@]}"
    ;;
esac
