#!/bin/zsh
set -euo pipefail

show_usage() {
  cat <<'EOF'
Usage:
  dartq <dart-command...>

Examples:
  dartq run bin/tool.dart
  dartq test
  dartq compile exe bin/tool.dart -o bin/tool
  dartq pub outdated
  dartq pub deps

Notes:
  - Injects low-noise Dart flags by default.
  - Compile command output is left to the outer command wrapper.
  - Prefers machine-readable output for pub outdated.
EOF
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "dartq: missing required command: $1" >&2
    exit 1
  }
}

deny_command() {
  local command_name="$1"
  echo "dartq: forbidden command: $command_name" >&2
  exit 2
}

contains_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done
  return 1
}

contains_prefix_arg() {
  local prefix="$1"
  shift
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$prefix"* ]]; then
      return 0
    fi
  done
  return 1
}

run_compile_command() {
  local -a compile_cmd=("$@")
  exec "${compile_cmd[@]}"
}

if [[ $# -eq 0 ]]; then
  show_usage >&2
  exit 2
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  show_usage
  exit 0
fi

require_cmd dart

if [[ "$1" == "help" ]] || contains_arg "--help" "$@" || contains_arg "-h" "$@"; then
  exec dart "$@"
fi

base_args=(
  "--suppress-analytics"
)

args=("$@")
command="$1"
subcommand="${2:-}"

if ! contains_arg "--suppress-analytics" "${args[@]}"; then
  args=("${base_args[@]}" "${args[@]}")
fi

case "$command" in
  format)
    deny_command "format"
    ;;
  run)
    deny_command "run"
    ;;
  test)
    exec dart "${args[@]}"
    ;;
  compile)
    if [[ -n "$subcommand" ]] && ! contains_prefix_arg "--verbosity" "${args[@]}"; then
      args=("${args[@]:0:3}" "--verbosity=warning" "${args[@]:3}")
    fi
    run_compile_command dart "${args[@]}"
    ;;
  pub)
    case "$subcommand" in
      outdated)
        if ! contains_arg "--json" "${args[@]}"; then
          args+=("--json")
        fi
        exec dart "${args[@]}"
        ;;
      deps|get|upgrade|workspace|add|remove|bump|unpack)
        if ! contains_arg "--no-color" "${args[@]}" && ! contains_arg "--color" "${args[@]}"; then
          args=("${args[@]:0:2}" "--no-color" "${args[@]:2}")
        fi
        exec dart "${args[@]}"
        ;;
      *)
        exec dart "${args[@]}"
        ;;
    esac
    ;;
  info|installed)
    exec dart "${args[@]}"
    ;;
  *)
    exec dart "${args[@]}"
    ;;
esac
