#!/bin/zsh
set -euo pipefail

show_help() {
  cat <<'EOF'
Usage: robdex-bootstrap <doctor|plan|apply|rollback|uninstall> [options]

Commands:
  doctor                         Read-only structured diagnostics
  plan --profile NAME            Print proposed bootstrap changes
  apply --profile NAME           Stage managed bootstrap files
  rollback --receipt PATH        Undo an apply receipt
  uninstall --work-dir PATH      Remove a managed bootstrap work directory

Options:
  --profile NAME                 minimal, orchestration, privileged-exec, gui, robertmsale.reference
  --codex-home PATH              Codex home; defaults to $CODEX_HOME or ~/.codex
  --work-dir PATH                Managed staging dir; defaults to $CODEX_HOME/robdex-bootstrap
  --bridge-port PORT             Bridge HTTP port; defaults to 42080
  --app-server-port PORT         App-server port; defaults to 4200
  --receipt PATH                 Receipt path for rollback

Output is newline-delimited JSON events for frontend consumption.
EOF
}

json_escape() {
  printf '%s' "$1" | /usr/bin/sed 's/\\/\\\\/g; s/"/\\"/g'
}

event() {
  local level="$1"
  local code="$2"
  local message="$3"
  printf '{"level":"%s","code":"%s","message":"%s"}\n' \
    "$(json_escape "$level")" \
    "$(json_escape "$code")" \
    "$(json_escape "$message")"
}

script_path="${0:A}"
script_dir="${script_path:h}"
robdex_home="${ROBDEX_HOME:-${script_dir:h}}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
state_home="${ROBDEX_STATE_HOME:-$codex_home/robdex}"
command_name="${1:-}"
shift || true
profile="minimal"
work_dir=""
bridge_port="${ROBDEX_BRIDGE_PORT:-42080}"
app_server_port="${ROBDEX_APP_SERVER_PORT:-4200}"
receipt_path=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      profile="${2:-}"
      shift 2
      ;;
    --codex-home)
      codex_home="${2:-}"
      shift 2
      ;;
    --work-dir)
      work_dir="${2:-}"
      shift 2
      ;;
    --bridge-port)
      bridge_port="${2:-}"
      shift 2
      ;;
    --app-server-port)
      app_server_port="${2:-}"
      shift 2
      ;;
    --receipt)
      receipt_path="${2:-}"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      event "error" "unknown_argument" "unknown argument: $1"
      show_help >&2
      exit 2
      ;;
  esac
done

work_dir="${work_dir:-$codex_home/robdex-bootstrap}"
profile_path="$robdex_home/configs/robdex/profiles/$profile.toml"
receipt_default="$work_dir/receipts/$profile.receipt"

check_profile() {
  if [[ ! -f "$profile_path" ]]; then
    event "error" "unknown_profile" "profile not found: $profile"
    exit 2
  fi
}

render_profile() {
  /usr/bin/sed \
    -e "s|\${ROBDEX_HOME}|$robdex_home|g" \
    -e "s|\${CODEX_HOME}|$codex_home|g" \
    -e "s|\${ROBDEX_STATE_HOME}|$state_home|g" \
    "$profile_path"
}

port_available() {
  local port="$1"
  if command -v nc >/dev/null 2>&1; then
    ! nc -z 127.0.0.1 "$port" >/dev/null 2>&1
  else
    return 0
  fi
}

emit_context() {
  printf '{"level":"info","code":"context","robdexHome":"%s","codexHome":"%s","stateHome":"%s","workDir":"%s","profile":"%s"}\n' \
    "$(json_escape "$robdex_home")" \
    "$(json_escape "$codex_home")" \
    "$(json_escape "$state_home")" \
    "$(json_escape "$work_dir")" \
    "$(json_escape "$profile")"
}

emit_plan() {
  check_profile
  emit_context
  event "info" "bridge_required" "Robdex GUI operation remains bridge-backed; no direct frontend-to-Codex app-server mode is configured."
  if port_available "$bridge_port"; then
    event "ok" "bridge_port_available" "bridge port $bridge_port is available"
  else
    event "warn" "bridge_port_in_use" "bridge port $bridge_port is already in use; connect to it or choose another port"
  fi
  if port_available "$app_server_port"; then
    event "ok" "app_server_port_available" "app-server port $app_server_port is available"
  else
    event "warn" "app_server_port_in_use" "app-server port $app_server_port is already in use; connect to it or choose another port"
  fi
  event "plan" "mkdir" "create managed work dir: $work_dir"
  event "plan" "profile_overlay" "render profile overlay from $profile_path"
  event "plan" "service_templates" "generate macOS launchd, Linux systemd-user, and supervisor templates for review"
  event "plan" "config_preserved" "existing $codex_home/config.toml will not be overwritten"
}

case "$command_name" in
  -h|--help|"")
    show_help
    ;;
  doctor)
    emit_context
    "$robdex_home/scripts/robdex-doctor" | while IFS= read -r line; do
      event "info" "doctor_line" "$line"
    done
    ;;
  plan)
    emit_plan
    ;;
  apply)
    emit_plan
    /bin/mkdir -p "$work_dir/profiles" "$work_dir/services" "$work_dir/receipts"
    render_profile >"$work_dir/profiles/$profile.toml"
    "$robdex_home/scripts/robdex-service-template" --platform macos --out-dir "$work_dir/services/macos" >/dev/null
    "$robdex_home/scripts/robdex-service-template" --platform linux --out-dir "$work_dir/services/linux" >/dev/null
    "$robdex_home/scripts/robdex-service-template" --platform supervisor --out-dir "$work_dir/services/supervisor" >/dev/null
    {
      printf 'work_dir=%s\n' "$work_dir"
      printf 'profile=%s\n' "$profile"
      printf 'codex_home=%s\n' "$codex_home"
      printf 'created=%s\n' "$work_dir/profiles/$profile.toml"
      printf 'created=%s\n' "$work_dir/services/macos"
      printf 'created=%s\n' "$work_dir/services/linux"
      printf 'created=%s\n' "$work_dir/services/supervisor"
    } >"$receipt_default"
    event "ok" "applied" "staged managed bootstrap files; receipt: $receipt_default"
    event "ok" "config_preserved" "did not modify $codex_home/config.toml"
    ;;
  rollback)
    [[ -n "$receipt_path" ]] || receipt_path="$receipt_default"
    if [[ ! -f "$receipt_path" ]]; then
      event "error" "missing_receipt" "receipt not found: $receipt_path"
      exit 1
    fi
    receipt_work_dir="$(/usr/bin/awk -F= '$1 == "work_dir" {print $2; exit}' "$receipt_path")"
    if [[ -z "$receipt_work_dir" ]]; then
      event "error" "invalid_receipt" "receipt does not contain work_dir: $receipt_path"
      exit 1
    fi
    /bin/rm -rf "$receipt_work_dir/profiles" "$receipt_work_dir/services"
    event "ok" "rolled_back" "removed staged profiles and services from $receipt_work_dir"
    event "ok" "config_preserved" "did not modify $codex_home/config.toml"
    ;;
  uninstall)
    /bin/rm -rf "$work_dir"
    event "ok" "uninstalled" "removed managed bootstrap work dir: $work_dir"
    event "ok" "config_preserved" "did not modify $codex_home/config.toml"
    ;;
  *)
    event "error" "unknown_command" "unknown command: $command_name"
    show_help >&2
    exit 2
    ;;
esac
