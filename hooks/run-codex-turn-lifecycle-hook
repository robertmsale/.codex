#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="/Users/robertsale/.codex/hooks"
LOG_DIR="$HOOK_DIR/logs"
mkdir -p "$LOG_DIR"

payload="$(cat)"
event_name="$(
  python3 -c 'import json,sys; data=json.loads(sys.stdin.read() or "{}"); print(data.get("hook_event_name") or "unknown")' <<<"$payload" 2>/dev/null || printf unknown
)"
session_id="$(
  python3 -c 'import json,sys; data=json.loads(sys.stdin.read() or "{}"); print(data.get("session_id") or "no-session")' <<<"$payload" 2>/dev/null || printf no-session
)"
turn_id="$(
  python3 -c 'import json,sys; data=json.loads(sys.stdin.read() or "{}"); print(data.get("turn_id") or "no-turn")' <<<"$payload" 2>/dev/null || printf no-turn
)"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
safe_event="${event_name//[^A-Za-z0-9_.-]/_}"
safe_session="${session_id//[^A-Za-z0-9_.-]/_}"
safe_turn="${turn_id//[^A-Za-z0-9_.-]/_}"
path="$LOG_DIR/${timestamp}.${safe_event}.${safe_session}.${safe_turn}.$$"

{
  printf 'argv:'
  printf ' %q' "$0" "$@"
  printf '\n'
  printf 'pwd: %s\n' "$PWD"
  printf 'timestamp_utc: %s\n' "$timestamp"
  printf 'env_CODEX_THREAD_ID: %s\n' "${CODEX_THREAD_ID:-}"
  printf 'env_ROBDEX_ROLE: %s\n' "${ROBDEX_ROLE:-}"
  printf 'stdin_json:\n%s\n' "$payload"
} > "$path.log"
