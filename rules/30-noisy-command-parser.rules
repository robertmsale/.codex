# Allow noisy commands when correctly routed through command-parser.
prefix_rule(
    pattern = ["cargo", ["check", "test", "clippy", "build", "bench", "nextest"]],
    decision = "forbidden",
    justification = "Use command-parser skill: ~/.codex/skills/command-parser/SKILL.md and run ~/.codex/skills/command-parser/scripts/command-parser <command>.",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    "cargo", ["check", "test", "clippy", "build", "bench", "nextest"]],
    decision = "allow",
)
prefix_rule(
    pattern = [
    "flutter", ["build", "test", "drive"]
    ],
    decision = "forbidden",
    justification = "Use command-parser skill: ~/.codex/skills/command-parser/SKILL.md and run ~/.codex/skills/command-parser/scripts/command-parser <command>.",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    "flutter", ["build", "test", "drive"]
    ],
    decision = "allow",
)
prefix_rule(
    pattern = [
    ["swift", "swift-build", "swiftc", "/usr/bin/swift", "/usr/bin/swiftc"], ["build", "test", "package"]],
    decision = "forbidden",
    justification = "Use command-parser skill: ~/.codex/skills/command-parser/SKILL.md and run ~/.codex/skills/command-parser/scripts/command-parser <command>.",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    ["swift", "swift-build", "swiftc", "/usr/bin/swift", "/usr/bin/swiftc"], ["build", "test", "package"]],
    decision = "allow",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    ["xcodebuild", "/usr/bin/xcodebuild", "pytest"]
    ],
    decision = "allow",
    justification = "xcodebuild is allowed on this system only with explicit approval.",
)
prefix_rule(
    pattern = [["xcodebuild", "/usr/bin/xcodebuild"]],
    decision = "prompt",
    justification = "xcodebuild is allowed on this system only with explicit approval.",
)
prefix_rule(
    pattern = [
    ["pytest", "go", "gradle", "./gradlew"], ["test", "build", "check", "verify", "lint", "run"]],
    decision = "forbidden",
    justification = "Use command-parser skill: ~/.codex/skills/command-parser/SKILL.md and run ~/.codex/skills/command-parser/scripts/command-parser <command>.",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"], 
    ["pytest", "go", "gradle", "./gradlew"], ["test", "build", "check", "verify", "lint", "run"]],
    decision = "allow",
)

# Direct noisy commands must not bypass command-parser.
prefix_rule(
    pattern = ["flutter", ["analyze"]],
    decision = "forbidden",
    justification = "Use the project's local code validation script instead.",
)
