# Hard ban for formatters.
prefix_rule(
    pattern = [
    ["pnpm", "npm"], 
    "exec", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    ["pnpm", "npm"], 
    "exec", "prettier"],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = [
    ["python", "python3"], 
    "-m", 
    "black"
    ],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = [
    ["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"],
    ["python", "python3"], 
    "-m", 
    "black"
    ],
    decision = "forbidden",
    justification = "absolutely never run these",
)
prefix_rule(
    pattern = [
