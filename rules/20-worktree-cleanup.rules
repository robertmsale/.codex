# Worktree cleanup enforcement (MCP-first).
prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "Use gitops MCP tool: git_worktree_cleanup(...).",
)
prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "forbidden",
    justification = "Branch deletion is intentionally out of scope for git_worktree_cleanup (path-only trash + prune).",
)
prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "forbidden",
    justification = "Remote branch deletion is intentionally out of scope for git_worktree_cleanup (path-only trash + prune).",
)
