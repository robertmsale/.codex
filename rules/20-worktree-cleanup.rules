# Worktree cleanup enforcement (MCP-first).
prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "Use gitops scripts",
)
prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "forbidden",
    justification = "Branch deletion must be handled with sanctioned gitops scripts.",
)
prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "forbidden",
    justification = "Remote branch deletion must be handled with sanctioned gitops scripts.",
)
