# Worktree cleanup enforcement (MCP-first).
prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "forbidden",
    justification = "Use gitops scripts",
)
prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "forbidden",
    justification = "Branch deletion must be handled with sanctioned gitops scripts.",
)
prefix_rule(
    pattern = ["git", "push", "origin", "--delete"],
    decision = "forbidden",
    justification = "Remote branch deletion must be handled with sanctioned gitops scripts.",
)
prefix_rule(
    pattern = [[
        "git-branch-list","~/.codex/skills/gh-version-control-workflow/scripts/git-branch-list", "/Users/robertsale/.codex/skills/gh-version-control-workflow/scripts/git-branch-list",
        "git-commit","~/.codex/skills/gh-version-control-workflow/scripts/git-commit", "/Users/robertsale/.codex/skills/gh-version-control-workflow/scripts/git-commit",
        "git-diff","~/.codex/skills/gh-version-control-workflow/scripts/git-diff", "/Users/robertsale/.codex/skills/gh-version-control-workflow/scripts/git-diff",
