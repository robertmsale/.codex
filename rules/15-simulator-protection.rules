# Prevent agents from nuking Simulator/CoreSimulator while still allowing normal builds.

prefix_rule(
    pattern = ["xcrun", "simctl", ["erase", "delete"]],
    decision = "forbidden",
    justification = "Do not destroy simulator state. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["xcrun", "simctl", "shutdown"],
    decision = "forbidden",
    justification = "Do not manually shut down simulators. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["simctl", ["erase", "delete"]],
    decision = "forbidden",
    justification = "Do not destroy simulator state. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["simctl", "shutdown"],
    decision = "forbidden",
    justification = "Do not manually shut down simulators. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["killall", ["Simulator", "com.apple.CoreSimulator.CoreSimulatorService"]],
    decision = "forbidden",
    justification = "Do not kill Simulator/CoreSimulatorService directly. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["pkill", ["Simulator", "com.apple.CoreSimulator.CoreSimulatorService"]],
    decision = "forbidden",
    justification = "Do not kill Simulator/CoreSimulatorService directly. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["pkill", "-f", ["Simulator", "CoreSimulator"]],
    decision = "forbidden",
    justification = "Do not kill Simulator/CoreSimulatorService directly. Use the broker's reboot flow instead.",
)
prefix_rule(
    pattern = ["launchctl", ["bootout", "kickstart"], ["gui/*/com.apple.CoreSimulator.CoreSimulatorService", "gui/*/com.apple.CoreSimulator.SimulatorTrampoline"]],
    decision = "forbidden",
    justification = "Do not restart CoreSimulator services directly. Use the broker's reboot flow instead.",
)

