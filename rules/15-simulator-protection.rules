    pattern = [["command-parser", "~/.codex/skills/command-parser/scripts/command-parser", "/Users/robertsale/.codex/skills/command-parser/scripts/command-parser"], "xcrun", "simctl", ["erase", "delete"]],
    decision = "forbidden",
    justification = "Do not destroy simulator state. Use the broker's reboot flow instead.",
)
