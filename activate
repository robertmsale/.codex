#!/usr/bin/env bash

_codex_activate_root="${HOME}/.codex"
if [[ $# -ge 1 && -d "${1}/skills" ]]; then
  _codex_activate_root="$1"
fi
_codex_skills_dir="${_codex_activate_root}/skills"
_codex_shim_dir="${_codex_activate_root}/shim"

if [[ ! -d "${_codex_skills_dir}" ]]; then
  echo "codex activate: skills directory not found: ${_codex_skills_dir}" >&2
  return 1 2>/dev/null || exit 1
fi

_codex_path_prefixes=()
while IFS= read -r _codex_scripts_dir; do
  _codex_path_prefixes+=("${_codex_scripts_dir}")
done < <(/usr/bin/find "${_codex_skills_dir}" -mindepth 1 -maxdepth 2 -type d -name scripts | sort)

if [[ ${#_codex_path_prefixes[@]} -eq 0 ]]; then
  echo "codex activate: no skill script directories found under ${_codex_skills_dir}" >&2
  return 1 2>/dev/null || exit 1
fi

_codex_clean_path=""
while IFS= read -r _codex_path_entry; do
  [[ -n "${_codex_path_entry}" ]] || continue
  case "${_codex_path_entry}" in
    "${_codex_skills_dir}/"*/scripts)
      [[ -d "${_codex_path_entry}" ]] || continue
      ;;
  esac
  _codex_clean_path="${_codex_clean_path:+${_codex_clean_path}:}${_codex_path_entry}"
done < <(printf '%s' "${PATH:-}" | tr ':' '\n')
export PATH="${_codex_clean_path}"

for _codex_scripts_dir in "${_codex_path_prefixes[@]}"; do
  case ":${PATH:-}:" in
    *:"${_codex_scripts_dir}":*)
      ;;
    *)
      export PATH="${_codex_scripts_dir}${PATH:+:${PATH}}"
      ;;
  esac
done

if [[ -d "${_codex_shim_dir}" ]]; then
  case ":${PATH:-}:" in
    *:"${_codex_shim_dir}":*)
      ;;
    *)
      export PATH="${_codex_shim_dir}${PATH:+:${PATH}}"
      ;;
  esac
fi

unset _codex_activate_root
unset _codex_skills_dir
unset _codex_shim_dir
unset _codex_path_prefixes
unset _codex_scripts_dir
unset _codex_clean_path
unset _codex_path_entry
