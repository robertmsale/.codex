{
  "id": "runtime-allow",
  "version": "1.0.0",
  "displayName": "Runtime Allow",
  "prompt": {
    "path": "prompts/runtime-allow.md"
  },
  "modelDefaults": {
    "model": "gpt-5.5",
    "reasoningEffort": "medium"
  },
  "capabilities": [
    "tool.execute_code",
    "tool.request_command_registry_change",
    "fs.read",
    "fs.write",
    "patch.apply",
    "workflow_memory.search",
    "workflow_memory.remember.project",
    "workflow_memory.remember.global",
    "workflow_memory.feedback",
    "command_registry.request",
    "command_registry.decide",
    "command_registry.apply",
    "file.head",
    "file.tail",
    "file.read_lines",
    "file.line_count",
    "file.search",
    "file.replace_exact",
    "tree.list",
    "tree.find",
    "git.status",
    "git.diff",
    "git.restore",
    "git.add",
    "git.commit",
    "server.start",
    "server.status",
    "server.logs",
    "server.stop",
    "image.capture_from_file",
    "image.describe",
    "tooling.request",
    "project_runtime.request_change"
  ],
  "policy": {
    "tool.execute_code": "allow",
    "fs.read": "allow",
    "fs.write": "allow",
    "patch.apply": "allow",
    "workflow_memory.search": "allow",
    "workflow_memory.remember.project": "allow",
    "workflow_memory.remember.global": "ownerApproval",
    "workflow_memory.feedback": "allow",
    "command_registry.request": "allow",
    "command_registry.decide": "allow",
    "command_registry.apply": "allow",
    "tool.request_command_registry_change": "allow",
    "file.head": "allow",
    "file.tail": "allow",
    "file.read_lines": "allow",
    "file.line_count": "allow",
    "file.search": "allow",
    "file.replace_exact": "allow",
    "tree.list": "allow",
    "tree.find": "allow",
    "git.status": "allow",
    "git.diff": "allow",
    "git.restore": "allow",
    "git.add": "allow",
    "git.commit": "allow",
    "server.start": "allow",
    "server.status": "allow",
    "server.logs": "allow",
    "server.stop": "allow",
    "image.capture_from_file": "allow",
    "image.describe": "allow",
    "tooling.request": "allow",
    "project_runtime.request_change": "allow"
  },
  "routing": {
    "mode": "direct",
    "defaultRecipient": "owner",
    "allowedRecipients": [
      "owner"
    ],
    "reservedActions": [
      "message.send",
      "message.route"
    ]
  },
  "visibility": {
    "listed": true,
    "ownerVisible": true
  },
  "lifecycleAuthority": {
    "canSpawnAgents": false,
    "canArchiveAgents": false,
    "reservedActions": [
      "agent.spawn.<role>",
      "agent.archive"
    ]
  }
}
