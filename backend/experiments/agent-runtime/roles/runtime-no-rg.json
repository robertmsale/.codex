{
  "id": "runtime-no-rg",
  "version": "1.0.0",
  "displayName": "Runtime No RG",
  "prompt": {
    "path": "prompts/runtime-no-rg.md"
  },
  "modelDefaults": {
    "model": "gpt-5.5",
    "reasoningEffort": "medium"
  },
  "capabilities": [
    "tool.execute_code",
    "tool.request_command_registry_change",
    "fs.read",
    "fs.write",
    "patch.apply",
    "workflow_memory.search",
    "workflow_memory.remember.project",
    "workflow_memory.remember.global",
    "workflow_memory.feedback",
    "command_registry.request",
    "command_registry.decide",
    "command_registry.apply"
  ],
  "policy": {
    "tool.execute_code": "allow",
    "fs.read": "allow",
    "fs.write": "deny",
    "patch.apply": "deny",
    "workflow_memory.search": "allow",
    "workflow_memory.remember.project": "deny",
    "workflow_memory.remember.global": "deny",
    "workflow_memory.feedback": "allow",
    "command_registry.request": "allow",
    "command_registry.decide": "allow",
    "command_registry.apply": "allow",
    "tool.request_command_registry_change": "allow"
  },
  "routing": {
    "mode": "direct",
    "defaultRecipient": "owner",
    "allowedRecipients": [
      "owner"
    ],
    "reservedActions": [
      "message.send",
      "message.route"
    ]
  },
  "visibility": {
    "listed": true,
    "ownerVisible": true
  },
  "lifecycleAuthority": {
    "canSpawnAgents": false,
    "canArchiveAgents": false,
    "reservedActions": [
      "agent.spawn.<role>",
      "agent.archive"
    ]
  }
}
