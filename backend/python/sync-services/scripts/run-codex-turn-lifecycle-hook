#!/bin/zsh
set -euo pipefail
exit 0
export ROBDEX_BRIDGE_HOOK_URL="http://127.0.0.1:42080/codex/hooks/turn-lifecycle"
HOOK_STDIN_PATH="/private/tmp/robdex-hook-stdin.json"
HOOK_ARGS_PATH="/private/tmp/robdex-hook-argv.txt"
HOOK_ENV_PATH="/private/tmp/robdex-hook-env.txt"
HOOK_META_PATH="/private/tmp/robdex-hook-meta.txt"

cat > "$HOOK_STDIN_PATH"

{
  printf 'argc=%s\n' "$#"
  i=1
  for arg in "$@"; do
    printf 'argv[%s]=%s\n' "$i" "$arg"
    i=$((i + 1))
  done
} > "$HOOK_ARGS_PATH"

{
  env | sort | rg '^(CODEX|ROBDEX|HOME=|PATH=|PWD=|SHELL=|USER=)'
} > "$HOOK_ENV_PATH" || true

{
  printf 'stdin_bytes=%s\n' "$(wc -c < "$HOOK_STDIN_PATH" | tr -d ' ')"
  printf 'pwd=%s\n' "$PWD"
  printf 'shell=%s\n' "$SHELL"
  printf 'time=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$HOOK_META_PATH"

echo "lifecycle" >> /private/tmp/hooktest
exec /Users/robertsale/.deno/bin/deno run -A \
  /Users/robertsale/.codex/backend/python/sync-services/scripts/codex_turn_lifecycle_hook.ts < "$HOOK_STDIN_PATH"
