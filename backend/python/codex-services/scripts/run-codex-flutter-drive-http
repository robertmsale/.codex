#!/bin/zsh
set -euo pipefail

repo_root="${0:A:h:h}"
cd "$repo_root"

export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/codex-services-uv-cache}"
export PATH="/opt/homebrew/opt/ruby/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export IDB_BIN="${IDB_BIN:-/Users/robertsale/.local/bin/idb}"
export FLUTTER_SIM_BROKER_BASE_URL="${FLUTTER_SIM_BROKER_BASE_URL:-http://127.0.0.1:8767}"
log_root="${CODEX_FLUTTER_DRIVE_LOG_ROOT:-$HOME/Library/Logs/codex-flutter-drive-http}"
timestamp="$(date +%Y%m%d-%H%M%S)"
launch_dir="$log_root/$timestamp"
mkdir -p "$launch_dir"
ln -sfn "$launch_dir" "$log_root/current"
export CODEX_FLUTTER_SIM_LOG_DIR="$launch_dir"

cat >"$launch_dir/launch.meta" <<EOF
launched_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
repo_root=$repo_root
bind=${CODEX_FLUTTER_DRIVE_BIND:-0.0.0.0}
port=${CODEX_FLUTTER_DRIVE_PORT:-8768}
idb_bin=$IDB_BIN
broker_base_url=$FLUTTER_SIM_BROKER_BASE_URL
EOF

exec /opt/homebrew/bin/uv run codex-flutter-drive-http --host "${CODEX_FLUTTER_DRIVE_BIND:-0.0.0.0}" --port "${CODEX_FLUTTER_DRIVE_PORT:-8768}" >>"$launch_dir/command.stdout.log" 2>>"$launch_dir/command.stderr.log"
