# Required for GitHub operations in remote review mode and github_* tools.
GITHUB_TOKEN=

# Review mode is controlled by operator only.
# local: run `codex exec ... review` with REQUEST_REVIEW_LOCAL_PROFILE
# remote: push + PR + @codex review polling
REQUEST_REVIEW_MODE=remote

# Optional override for protected branches that reject commit/review actions.
REQUEST_REVIEW_INTEGRATION_BRANCHES=main master staging prod production

# Remote review knobs.
REQUEST_REVIEW_BOT_LOGIN=chatgpt-codex-connector[bot]
REQUEST_REVIEW_TRIGGER_COMMENT=@codex review
REQUEST_REVIEW_POLL_INTERVAL_SECONDS=20
REQUEST_REVIEW_PR_BODY=Automated review request from gitops-mcp.
REQUEST_REVIEW_BASE_BRANCH=

# Local review knobs.
REQUEST_REVIEW_LOCAL_PROFILE=local-review
REQUEST_REVIEW_LOCAL_OUTPUT_FILE=review.log
REQUEST_REVIEW_LOCAL_ERROR_FILE=review.err.log
REQUEST_REVIEW_LOCAL_KEEP_DEBUG_LOGS=0

# Operator kill-switch. When 1, review execution is bypassed and tool returns `all clear!`.
REQUEST_REVIEW_DISABLE=0

# Optional worktree defaults.
GITOPS_INTEGRATION_BRANCH=integration
GITOPS_WORKTREE_DIR=.worktrees
