#!/bin/bash
set -euo pipefail

state_root="${PUBLIC_DEV_TUNNEL_STATE_DIR:-/tmp/codex-public-dev-tunnels}"
provider="${PUBLIC_DEV_TUNNEL_PROVIDER:-cloudflared}"

usage() {
  cat >&2 <<'EOF'
Usage:
  public-dev-tunnel start <local_base_url> [name]
  public-dev-tunnel url [name]
  public-dev-tunnel status [name]
  public-dev-tunnel logs [name]
  public-dev-tunnel stop [name]

Examples:
  public-dev-tunnel start http://127.0.0.1:49291 qbo-oauth-pilot
  public-dev-tunnel url qbo-oauth-pilot
  public-dev-tunnel stop qbo-oauth-pilot
EOF
}

fail() {
  echo "public-dev-tunnel: $*" >&2
  exit 1
}

require_name() {
  local raw="${1:-default}"
  [[ "$raw" =~ ^[A-Za-z0-9._-]+$ ]] || fail "invalid tunnel name: $raw"
  printf '%s\n' "$raw"
}

paths_for() {
  local name="$1"
  mkdir -p "$state_root"
  tunnel_dir="$state_root/$name"
  pid_file="$tunnel_dir/pid"
  url_file="$tunnel_dir/url"
  log_file="$tunnel_dir/log"
}

is_running() {
  local pid=""
  [[ -f "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" >/dev/null 2>&1
}

require_cloudflared() {
  command -v cloudflared >/dev/null 2>&1 && return 0
  fail "cloudflared is required. Install with: brew install cloudflared"
}

extract_cloudflared_url() {
  awk '
    match($0, /https:\/\/[A-Za-z0-9.-]+\.trycloudflare\.com/) {
      print substr($0, RSTART, RLENGTH)
      exit
    }
  ' "$log_file"
}

cmd_start() {
  [[ $# -ge 1 && $# -le 2 ]] || { usage; exit 2; }
  local local_url="$1"
  local name
  name="$(require_name "${2:-default}")"
  [[ "$local_url" == http://127.0.0.1:* || "$local_url" == http://localhost:* ]] || \
    fail "local_base_url must start with http://127.0.0.1:<port> or http://localhost:<port>"
  require_cloudflared
  paths_for "$name"
  mkdir -p "$tunnel_dir"
  if is_running; then
    [[ -s "$url_file" ]] || fail "tunnel '$name' is running but no public URL has been captured yet; inspect: $log_file"
    cat "$url_file"
    exit 0
  fi
  rm -f "$pid_file" "$url_file"
  : >"$log_file"
  nohup cloudflared tunnel --url "$local_url" --no-autoupdate >"$log_file" 2>&1 &
  local pid=$!
  printf '%s\n' "$pid" >"$pid_file"

  local public_url=""
  for _ in {1..80}; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      fail "cloudflared exited before publishing a URL; inspect: $log_file"
    fi
    public_url="$(extract_cloudflared_url || true)"
    if [[ -n "$public_url" ]]; then
      printf '%s\n' "$public_url" >"$url_file"
      printf '%s\n' "$public_url"
      exit 0
    fi
    sleep 0.25
  done
  fail "timed out waiting for public URL; inspect: $log_file"
}

cmd_url() {
  [[ $# -le 1 ]] || { usage; exit 2; }
  local name
  name="$(require_name "${1:-default}")"
  paths_for "$name"
  is_running || fail "tunnel '$name' is not running"
  [[ -s "$url_file" ]] || fail "public URL has not been captured yet; inspect: $log_file"
  cat "$url_file"
}

cmd_status() {
  [[ $# -le 1 ]] || { usage; exit 2; }
  local name
  name="$(require_name "${1:-default}")"
  paths_for "$name"
  if is_running; then
    echo "running: $name" >&2
    [[ -s "$url_file" ]] && cat "$url_file"
    exit 0
  fi
  fail "tunnel '$name' is not running"
}

cmd_logs() {
  [[ $# -le 1 ]] || { usage; exit 2; }
  local name
  name="$(require_name "${1:-default}")"
  paths_for "$name"
  [[ -f "$log_file" ]] || fail "no log exists for tunnel '$name'"
  tail -n 120 "$log_file"
}

cmd_stop() {
  [[ $# -le 1 ]] || { usage; exit 2; }
  local name
  name="$(require_name "${1:-default}")"
  paths_for "$name"
  if is_running; then
    local pid
    pid="$(cat "$pid_file")"
    kill "$pid" >/dev/null 2>&1 || true
    for _ in {1..20}; do
      kill -0 "$pid" >/dev/null 2>&1 || break
      sleep 0.1
    done
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$pid_file" "$url_file"
  echo "stopped: $name" >&2
}

cmd="${1:-}"
shift || true
case "$cmd" in
  start) cmd_start "$@" ;;
  url) cmd_url "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  stop) cmd_stop "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 2 ;;
esac
