#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
codex_root="$(cd "$script_dir/../../.." && pwd)"
source "$codex_root/scripts/privileged_exec_bypass.sh"
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 2 ]]; then
  echo "Usage: git-unstage-paths <repo_or_worktree_path> <path> [path...]" >&2
  exit 2
fi

run_via_privileged_exec_bypass_script "$script_dir/git-unstage-paths" "$@"

repo_path="$(normalize_mirrored_path "$1")"
shift
git_unstage_paths_cmd "$repo_path" "$@"
