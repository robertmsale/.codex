#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
codex_root="$(cd "$script_dir/../../.." && pwd)"

# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"
source "$codex_root/scripts/privileged_exec_bypass.sh"

if [[ $# -lt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-commit <worktree_path> <message> [--allow-empty] [--no-add]
EOF
  exit 2
fi

run_via_privileged_exec_bypass_script "$script_dir/git-commit" "$@"

worktree_path="$(normalize_mirrored_path "$1")"
message="$2"
shift 2

allow_empty=0
do_add=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-empty) allow_empty=1 ;;
    --no-add) do_add=0 ;;
    *)
      echo "Unknown flag: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -z "${message// }" ]]; then
  echo "Commit message is required" >&2
  exit 2
fi

allow_empty_flag=false
add_all_flag=true
if [[ "$allow_empty" -eq 1 ]]; then
  allow_empty_flag=true
fi
if [[ "$do_add" -eq 0 ]]; then
  add_all_flag=false
fi

git_commit_cmd "$worktree_path" "$message" "$allow_empty_flag" "$add_all_flag"
