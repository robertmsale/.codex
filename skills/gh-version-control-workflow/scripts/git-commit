#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-commit <worktree_path> <message> [--allow-empty] [--no-add]
EOF
  exit 2
fi

worktree_path="$(normalize_mirrored_path "$1")"
message="$2"
shift 2

allow_empty=0
do_add=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-empty) allow_empty=1 ;;
    --no-add) do_add=0 ;;
    *)
      echo "Unknown flag: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [[ -z "${message// }" ]]; then
  echo "Commit message is required" >&2
  exit 2
fi

args=("worktree_path=$worktree_path" "message=$message")
if [[ "$allow_empty" -eq 1 ]]; then
  args+=("allow_empty=true")
fi
if [[ "$do_add" -eq 0 ]]; then
  args+=("add_all=false")
fi
http_gitops_op git_commit "${args[@]}"
