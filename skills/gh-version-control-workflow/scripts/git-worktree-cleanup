#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-cleanup <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$(normalize_mirrored_path "$1")"
integration_branch_arg="${2:-}"
cleanup_warnings=()

warn() {
  local message="$1"
  cleanup_warnings+=("$message")
}

best_effort_rm_rf() {
  local target="$1"
  local attempt

  for attempt in 1 2 3; do
    [[ -e "$target" ]] || return 0
    rm -rf "$target" >/dev/null 2>&1 || true
    [[ -e "$target" ]] || return 0
    sleep 0.2
  done

  [[ ! -e "$target" ]]
}

print_cleanup_result() {
  local summary="$1"
  printf '%s\n' "$summary"
  if [[ "${#cleanup_warnings[@]}" -gt 0 ]]; then
    local warning
    for warning in "${cleanup_warnings[@]}"; do
      printf 'WARNING: %s\n' "$warning"
    done
  fi
}

stash_worktree_if_dirty() {
  local worktree="$1"
  local stash_name="$2"

  if [[ -z "$(git -C "$worktree" status --short)" ]]; then
    return 1
  fi

  git -C "$worktree" stash push -u -m "$stash_name" >/dev/null
  printf '%s\n' "$stash_name"
  return 0
}

sync_integration_branch() {
  local repo_root="$1"
  local integration_branch="$2"
  local current_branch=""
  local stashed=0

  [[ -n "$integration_branch" ]] || return 0

  git -C "$repo_root" fetch -q origin "$integration_branch"

  current_branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  if [[ "$current_branch" != "$integration_branch" ]]; then
    return 0
  fi

  if [[ -n "$(git -C "$repo_root" status --short)" ]]; then
    git -C "$repo_root" stash push -u -m "git-worktree-cleanup-$integration_branch" >/dev/null
    stashed=1
  fi

  git -C "$repo_root" merge --ff-only "origin/$integration_branch" >/dev/null

  if [[ "$stashed" -eq 1 ]]; then
    git -C "$repo_root" stash pop >/dev/null || {
      warn "repo-root stash pop reported conflicts after syncing $integration_branch"
      return 0
    }
  fi
}

remove_worktree_path() {
  local repo_root="$1"
  local wt_abs="$2"
  local empty_dir=""
  local remove_stderr=""
  local removed=0

  remove_stderr="$(git -C "$repo_root" worktree remove --force "$wt_abs" 2>&1 >/dev/null)" && removed=1 || true
  if [[ "$removed" -eq 1 ]]; then
    return 0
  fi

  if [[ ! -e "$wt_abs" ]]; then
    return 0
  fi

  if command -v rsync >/dev/null 2>&1; then
    empty_dir="$(mktemp -d "${TMPDIR:-/tmp}/git-worktree-cleanup-empty.XXXXXX")"
    rsync -a --delete "$empty_dir"/ "$wt_abs"/ >/dev/null 2>&1 || true
    rmdir "$wt_abs" >/dev/null 2>&1 || true
    rm -rf "$empty_dir" >/dev/null 2>&1 || true
  fi

  if [[ -e "$wt_abs" ]]; then
    best_effort_rm_rf "$wt_abs" || true
  fi

  if [[ -e "$wt_abs" ]]; then
    warn "best-effort cleanup left the worktree path on disk: $wt_abs${remove_stderr:+ ($remove_stderr)}"
  elif [[ -n "$remove_stderr" ]]; then
    warn "git worktree remove needed fallback cleanup for $wt_abs: $remove_stderr"
  fi

  return 0
}

if [[ ! -e "$worktree_path" ]]; then
  echo "all clear: worktree path is already missing"
  exit 0
fi

if ! have_local_git_repo "$worktree_path"; then
  if ! bridge_fallback_allowed; then
    echo "Path is not a valid local git worktree: $worktree_path" >&2
    exit 2
  fi
  args=("worktree_path=$worktree_path")
  if [[ -n "$integration_branch_arg" ]]; then
    args+=("integration_branch=$integration_branch_arg")
  fi
  cleanup_output="$(http_gitops_op git_worktree_cleanup "${args[@]}")"
  remove_shadow_worktree_path "$worktree_path"
  printf '%s\n' "$cleanup_output"
  exit 0
fi

resolved_output="$(resolve_worktree "$worktree_path")"
wt_abs="$(printf '%s\n' "$resolved_output" | sed -n '1p')"
repo_root="$(printf '%s\n' "$resolved_output" | sed -n '2p')"
integration_branch="$(resolve_integration_branch "$repo_root" "$integration_branch_arg")"
branch="$(git -C "$wt_abs" rev-parse --abbrev-ref HEAD)"
worktree_stash_name=""

worktree_stash_name="git-worktree-cleanup-$branch-$(date +%s)"
if ! worktree_stash_name="$(stash_worktree_if_dirty "$wt_abs" "$worktree_stash_name")"; then
  worktree_stash_name=""
fi

sync_integration_branch "$repo_root" "$integration_branch"

remove_worktree_path "$repo_root" "$wt_abs"
if ! git -C "$repo_root" worktree prune --expire now >/dev/null 2>&1; then
  warn "git worktree prune reported a cleanup issue for $wt_abs"
fi

if [[ -n "$worktree_stash_name" ]]; then
  summary="$(printf 'Synced %s to origin/%s, stashed %s, and cleaned worktree: %s' "$repo_root" "$integration_branch" "$worktree_stash_name" "$wt_abs")"
else
  summary="$(printf 'Synced %s to origin/%s and cleaned worktree: %s' "$repo_root" "$integration_branch" "$wt_abs")"
fi

if [[ -e "$wt_abs" ]]; then
  warn "worktree path still exists after cleanup: $wt_abs"
fi

if git -C "$repo_root" worktree list --porcelain | grep -Fx "worktree $wt_abs" >/dev/null; then
  warn "worktree is still registered after cleanup: $wt_abs"
fi

print_cleanup_result "$summary"
