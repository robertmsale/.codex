#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-cleanup <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$1"
integration_branch_arg="${2:-}"

remove_worktree_path() {
  local repo_root="$1"
  local wt_abs="$2"
  local empty_dir=""

  if git -C "$repo_root" worktree remove --force "$wt_abs" >/dev/null 2>&1; then
    return 0
  fi

  if [[ ! -e "$wt_abs" ]]; then
    return 0
  fi

  if ! command -v rsync >/dev/null 2>&1; then
    echo "git worktree remove failed and rsync is unavailable for fallback cleanup: $wt_abs" >&2
    return 1
  fi

  empty_dir="$(mktemp -d "${TMPDIR:-/tmp}/git-worktree-cleanup-empty.XXXXXX")"
  echo "git worktree remove failed for $wt_abs; retrying with empty-dir rsync fallback" >&2
  rsync -a --delete "$empty_dir"/ "$wt_abs"/ >/dev/null
  rmdir "$wt_abs"
  rm -rf "$empty_dir"
}

if [[ ! -e "$worktree_path" ]]; then
  echo "all clear: worktree path is already missing"
  exit 0
fi

if ! git -C "$worktree_path" rev-parse --git-dir >/dev/null 2>&1; then
  http_gitops_op git_worktree_cleanup "worktree_path=$worktree_path"
  exit 0
fi

resolved_output="$(resolve_worktree "$worktree_path")"
wt_abs="$(printf '%s\n' "$resolved_output" | sed -n '1p')"
repo_root="$(printf '%s\n' "$resolved_output" | sed -n '2p')"
integration_branch="$(resolve_integration_branch "$repo_root" "$integration_branch_arg")"
stash_ref=""
stash_label=""

if [[ -n "$(git -C "$repo_root" status --short)" ]]; then
  stash_label="git-worktree-cleanup:auto-stash:$(date -u +%Y%m%dT%H%M%SZ)"
  git -C "$repo_root" stash push -u -m "$stash_label" >/dev/null
  stash_ref="$(git -C "$repo_root" stash list --format='%gd %s' | awk -v label="$stash_label" '$0 ~ label {print $1; exit}')"
fi

git -C "$repo_root" fetch -q origin "$integration_branch"
git -C "$repo_root" pull --ff-only origin "$integration_branch" >/dev/null

if [[ -n "$stash_ref" ]]; then
  git -C "$repo_root" stash pop "$stash_ref" >/dev/null
fi

remove_worktree_path "$repo_root" "$wt_abs"
git -C "$repo_root" worktree prune --expire now >/dev/null

if [[ -e "$wt_abs" ]]; then
  echo "Worktree path still exists after cleanup: $wt_abs" >&2
  exit 1
fi

if git -C "$repo_root" worktree list --porcelain | grep -Fx "worktree $wt_abs" >/dev/null; then
  echo "Worktree is still registered after cleanup: $wt_abs" >&2
  exit 1
fi

printf 'Synced %s to origin/%s and cleaned worktree: %s\n' "$repo_root" "$integration_branch" "$wt_abs"
