#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-cleanup <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$(normalize_mirrored_path "$1")"
integration_branch_arg="${2:-}"

if [[ ! -e "$worktree_path" ]]; then
  echo "all clear: worktree path is already missing"
  exit 0
fi

args=("worktree_path=$worktree_path")
if [[ -n "$integration_branch_arg" ]]; then
  args+=("integration_branch=$integration_branch_arg")
fi
cleanup_output="$(http_gitops_op git_worktree_cleanup "${args[@]}")"
remove_shadow_worktree_path "$worktree_path"
printf '%s\n' "$cleanup_output"
