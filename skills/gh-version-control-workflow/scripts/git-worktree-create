#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
codex_root="$(cd "$script_dir/../../.." && pwd)"

source "$codex_root/scripts/privileged_exec_bypass.sh"

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-create <repo_path> <base_branch> <branch_name> <worktree_name>
EOF
  exit 0
fi

run_via_privileged_exec_bypass_script "$script_dir/git-worktree-create" "$@"

# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -ne 4 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-create <repo_path> <base_branch> <branch_name> <worktree_name>
EOF
  exit 2
fi

repo_path="$(normalize_mirrored_path "$1")"
base_branch="$2"
branch_name="$3"
worktree_name="$4"

repo_abs="$(absolute_path "$repo_path")"
git_worktree_create_cmd "$repo_abs" "$base_branch" "$branch_name" "$worktree_name"
