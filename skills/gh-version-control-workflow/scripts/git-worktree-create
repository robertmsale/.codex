#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -ne 4 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-worktree-create <repo_path> <base_branch> <branch_name> <worktree_name>
EOF
  exit 2
fi

repo_path="$(normalize_mirrored_path "$1")"
base_branch="$2"
branch_name="$3"
worktree_name="$4"

repo_abs="$(absolute_path "$repo_path")"
git_worktree_create_cmd "$repo_abs" "$base_branch" "$branch_name" "$worktree_name"
