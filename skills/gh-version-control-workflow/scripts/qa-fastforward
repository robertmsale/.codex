#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
codex_root="$(cd "$script_dir/../../.." && pwd)"

source "$codex_root/scripts/privileged_exec_bypass.sh"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  qa-fastforward <worktree_path> [integration_branch]
EOF
  exit 2
fi

run_via_privileged_exec_bypass_script "$script_dir/qa-fastforward" "$@"

worktree_path="$(normalize_mirrored_path "$1")"
integration_branch_arg="${2:-}"

qa_fastforward_cmd "$worktree_path" "$integration_branch_arg"
