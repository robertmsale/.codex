#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -ne 2 ]]; then
  echo "Usage: git-show <repo_or_worktree_path> <object>" >&2
  exit 2
fi

path="$(normalize_mirrored_path "$1")"
object="$2"

http_gitops_op visibility_git_show "repo_path=$path" "object=$object"
