#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -ne 1 ]]; then
  echo "Usage: git-rebase-abort <repo_or_worktree_path>" >&2
  exit 2
fi

path="$1"

if have_local_git_repo "$path"; then
  git -C "$path" rebase --abort
else
  http_gitops_op git_rebase_abort "repo_path=$path"
fi
