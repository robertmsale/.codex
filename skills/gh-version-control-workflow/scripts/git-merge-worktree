#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  cat >&2 <<'EOF'
Usage:
  git-merge-worktree <worktree_path> [integration_branch]
EOF
  exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-merge-worktree <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$1"
integration_branch_arg="${2:-}"

if ! have_local_git_repo "$worktree_path"; then
  args=("worktree_path=$worktree_path")
  if [[ -n "$integration_branch_arg" ]]; then
    args+=("integration_branch=$integration_branch_arg")
  fi
  http_gitops_op git_merge_worktree "${args[@]}"
  exit 0
fi

resolved_output="$(resolve_worktree "$worktree_path")"
wt_abs="$(printf '%s\n' "$resolved_output" | sed -n '1p')"
repo_root="$(printf '%s\n' "$resolved_output" | sed -n '2p')"
branch="$(git -C "$wt_abs" rev-parse --abbrev-ref HEAD)"
require_non_integration_branch "$branch"
integration_branch="$(resolve_integration_branch "$repo_root" "$integration_branch_arg")"

if [[ -n "$(git -C "$wt_abs" status --short)" ]]; then
  echo "Refusing to merge a dirty worktree: $wt_abs" >&2
  exit 2
fi

pr_number="$(cd "$wt_abs" && gh pr view --json number --jq '.number')"
if [[ -z "$pr_number" ]]; then
  echo "No PR found for worktree branch: $branch" >&2
  exit 2
fi

(cd "$wt_abs" && gh pr merge "$pr_number" --squash >/dev/null)

if git -C "$repo_root" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1; then
  git -C "$repo_root" push -q origin --delete "$branch" >/dev/null
fi

cleanup_output="$("$script_dir/git-worktree-cleanup" "$wt_abs" "$integration_branch")"

if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
  git -C "$repo_root" branch -D "$branch" >/dev/null
fi

git -C "$repo_root" fetch -q origin --prune

printf 'Squash-merged PR #%s, deleted origin/%s, removed local branch %s, and cleaned worktree. %s\n' \
  "$pr_number" \
  "$branch" \
  "$branch" \
  "$cleanup_output"
