#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-sync-worktree <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$1"
base_branch="${2:-${GITOPS_INTEGRATION_BRANCH:-master}}"

if ! have_local_git_repo "$worktree_path"; then
  if ! bridge_fallback_allowed; then
    echo "Path is not a valid local git worktree: $worktree_path" >&2
    exit 2
  fi
  http_gitops_op git_sync_worktree "worktree_path=$worktree_path" "upstream=origin/$base_branch"
  exit 0
fi

resolved_output="$(resolve_worktree "$worktree_path")"
wt_abs="$(printf '%s\n' "$resolved_output" | sed -n '1p')"

branch="$(git -C "$wt_abs" rev-parse --abbrev-ref HEAD)"
require_non_integration_branch "$branch"

git -C "$wt_abs" fetch -q origin --prune
git -C "$wt_abs" rebase --quiet --autostash "origin/$base_branch"

printf 'Synced %s onto origin/%s\n' "$branch" "$base_branch"
