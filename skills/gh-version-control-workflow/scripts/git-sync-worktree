#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-sync-worktree <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$(normalize_mirrored_path "$1")"
base_branch="${2:-${GITOPS_INTEGRATION_BRANCH:-master}}"

http_gitops_op git_sync_worktree "worktree_path=$worktree_path" "upstream=origin/$base_branch"
