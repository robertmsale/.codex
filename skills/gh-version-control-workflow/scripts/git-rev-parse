#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: git-rev-parse <repo_or_worktree_path> [ref]" >&2
  exit 2
fi

path="$(normalize_mirrored_path "$1")"
ref="${2:-HEAD}"

if have_local_git_repo "$path"; then
  git -C "$path" rev-parse --verify "$ref"
else
  http_gitops_op visibility_git_rev_parse "repo_path=$path" "ref=$ref"
fi
