#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -ne 1 ]]; then
  echo "Usage: git-status <repo_or_worktree_path>" >&2
  exit 2
fi

path="$1"
if have_local_git_repo "$path"; then
  git -C "$path" status --short --branch
else
  if ! bridge_fallback_allowed; then
    echo "Path is not a valid local git repository: $path" >&2
    exit 2
  fi
  http_gitops_op visibility_git_status "repo_path=$path"
fi
