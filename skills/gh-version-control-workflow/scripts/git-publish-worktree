#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_worktree_lib.sh
source "$script_dir/_worktree_lib.sh"

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  cat >&2 <<'EOF'
Usage:
  git-publish-worktree <worktree_path> [integration_branch]
EOF
  exit 0
fi

if [[ $# -lt 1 || $# -gt 2 ]]; then
  cat >&2 <<'EOF'
Usage:
  git-publish-worktree <worktree_path> [integration_branch]
EOF
  exit 2
fi

worktree_path="$(normalize_mirrored_path "$1")"
base_branch="${2:-${GITOPS_INTEGRATION_BRANCH:-master}}"

if [[ ! -d "$worktree_path" ]]; then
  echo "Worktree path does not exist: $worktree_path" >&2
  exit 2
fi

if [[ ! -f "$worktree_path/review.log" ]]; then
  echo "Publish blocked: review.log not found in worktree root. Request review first." >&2
  exit 2
fi

http_gitops_op git_publish_worktree "worktree_path=$worktree_path" "integration_branch=$base_branch"
