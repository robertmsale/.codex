#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: git-branch-list <repo_or_worktree_path> [--local-only]" >&2
  exit 2
fi

path="$(normalize_mirrored_path "$1")"
local_only=0
if [[ "${2:-}" == "--local-only" ]]; then
  local_only=1
fi

if have_local_git_repo "$path"; then
  if [[ "$local_only" -eq 1 ]]; then
    git -C "$path" branch --verbose --verbose
  else
    git -C "$path" branch --all --verbose --verbose
  fi
else
  if ! bridge_fallback_allowed; then
    echo "Path is not a valid local git repository: $path" >&2
    exit 2
  fi
  if [[ "$local_only" -eq 1 ]]; then
    http_gitops_op visibility_git_branch_list "repo_path=$path" "all=false"
  else
    http_gitops_op visibility_git_branch_list "repo_path=$path" "all=true"
  fi
fi
