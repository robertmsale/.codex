#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/_worktree_lib.sh"

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "Usage: git-diff <repo_or_worktree_path> [ref] [pathspec]" >&2
  exit 2
fi

path="$(normalize_mirrored_path "$1")"
ref="${2:-}"
pathspec="${3:-}"

args=("repo_path=$path")
if [[ -n "$ref" ]]; then
  args+=("ref=$ref")
fi
if [[ -n "$pathspec" ]]; then
  args+=("pathspec=$pathspec")
fi
http_gitops_op visibility_git_diff "${args[@]}"
