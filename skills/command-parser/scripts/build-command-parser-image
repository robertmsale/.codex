#!/usr/bin/env bash
set -euo pipefail

shared_builder="${HOME}/.codex/scripts/build-codex-agent-image"
if [[ ! -x "$shared_builder" ]]; then
  echo "Error: missing shared builder: $shared_builder" >&2
  exit 1
fi

CODEX_AGENT_IMAGE="${COMMAND_PARSER_IMAGE:-command-parser:0.110.0}" \
CODEX_AGENT_CODEX_VERSION="${COMMAND_PARSER_CODEX_VERSION:-0.110.0}" \
  exec "$shared_builder"
