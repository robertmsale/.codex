#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${FLUTTER_HTTP_SERVER_BASE_URL:-http://127.0.0.1:8769}"
REAL_FLUTTER_BIN="${REAL_FLUTTER_BIN:-/Users/robertsale/.codex/scripts/flutterq}"
BROKER_ROOTS=(
  "/Users/robertsale/Code/ezra/ezra"
  "/Users/robertsale/Code/ezra/qa"
)

resolve_broker_passthru_flutter() {
  local self_path
  local candidate=""
  self_path="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    [[ "$candidate" == "$self_path" ]] && continue
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(which -a flutter 2>/dev/null || true)

  if [[ -x /opt/homebrew/bin/flutter ]]; then
    printf '%s\n' "/opt/homebrew/bin/flutter"
    return 0
  fi

  echo "flutter wrapper: unable to resolve passthrough flutter binary" >&2
  return 1
}

if [[ $# -eq 0 ]]; then
  echo "Usage: flutter <args...>" >&2
  exit 64
fi

if [[ "${CODEX_FLUTTER_HTTP_ACTIVE:-0}" == "1" ]]; then
  passthru_flutter="$(resolve_broker_passthru_flutter)"
  exec /bin/bash -lc 'exec "$@"' bash "$passthru_flutter" "$@"
fi

should_use_broker=false
for root in "${BROKER_ROOTS[@]}"; do
  if [[ "$PWD" == "$root" || "$PWD" == "$root"/* ]]; then
    should_use_broker=true
    break
  fi
done

if [[ "$should_use_broker" != true ]]; then
  exec "$REAL_FLUTTER_BIN" "$@"
fi

BODY="$(
  python3 - "$PWD" "$@" <<'PY'
import json
import sys

cwd = sys.argv[1]
argv = sys.argv[2:]
print(json.dumps({"cwd": cwd, "argv": argv}))
PY
)"

RESPONSE="$(curl -fsS -X POST -H 'Content-Type: application/json' "$BASE_URL/run" -d "$BODY")"

RESPONSE_FILE="$(mktemp)"
trap 'rm -f "$RESPONSE_FILE"' EXIT
printf '%s' "$RESPONSE" > "$RESPONSE_FILE"

python3 - "$RESPONSE_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8") as fh:
    payload = json.load(fh)
stdout = payload.get("stdout") or ""
stderr = payload.get("stderr") or ""
if stdout:
    sys.stdout.write(stdout)
if stderr:
    sys.stderr.write(stderr)
raise SystemExit(int(payload.get("returncode", 1)))
PY
