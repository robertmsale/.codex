#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${FLUTTER_SIM_SERVER_BASE_URL:-http://127.0.0.1:8767}"
COMMAND="${1:-}"
shift || true

DEVICE_ID_ARG=""
JSON=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device-id)
      DEVICE_ID_ARG="$2"
      shift 2
      ;;
    --json)
      JSON=1
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 64
      ;;
  esac
done

request() {
  local method="$1"
  local endpoint="$2"
  local body="${3:-}"
  if [[ -n "$body" ]]; then
    curl -fsS -X "$method" -H 'Content-Type: application/json' "$BASE_URL$endpoint" -d "$body"
  else
    curl -fsS -X "$method" "$BASE_URL$endpoint"
  fi
}

log_progress() {
  local message="$1"
  printf '%s\n' "$message" >&2
}

render() {
  local payload="$1"
  local mode="$2"
  PAYLOAD="$payload" python3 - "$mode" <<'PY'
import json
import os
import sys

mode = sys.argv[1]
payload = json.loads(os.environ["PAYLOAD"])

if mode == "json":
    print(json.dumps(payload, indent=2))
    raise SystemExit(0)

if mode == "devices":
    for device in payload.get("devices", []):
        reservation = device.get("reservation_path") or "-"
        print(f"{device.get('device_id')}\t{device.get('name')}\t{device.get('state')}\t{reservation}")
    raise SystemExit(0)

if mode == "session":
    session = payload.get("session")
    if not session:
        print("No session.")
        raise SystemExit(0)
    print(f"Device: {session.get('device_name')} ({session.get('device_id')})")
    print(f"State: {session.get('state')}")
    print(f"Path: {session.get('path')}")
    print(f"Launch Path: {session.get('launch_path')}")
    if session.get("lane_root"):
        print(f"Lane: {session.get('lane_root')}")
    print(f"Target: {session.get('target')}")
    if session.get("dtd_uri"):
        print(f"DTD: {session.get('dtd_uri')}")
    if session.get("app_uri"):
        print(f"App: {session.get('app_uri')}")
    api = session.get("api") or {}
    if api.get("connection_domain"):
        print(f"Connection Domain: {api.get('connection_domain')}")
    if api.get("base_url"):
        print(f"API: {api.get('base_url')}")
    if api.get("login_email") or api.get("login_password"):
        print(f"Login: {api.get('login_email')} / {api.get('login_password')}")
    if session.get("last_error"):
        print(f"Error: {session.get('last_error')}")
    raise SystemExit(0)

print(payload.get("message", ""))
session = payload.get("session")
if session:
    print(f"Device: {session.get('device_name')} ({session.get('device_id')})")
    print(f"State: {session.get('state')}")
    print(f"Path: {session.get('path')}")
    print(f"Launch Path: {session.get('launch_path')}")
    if session.get("lane_root"):
        print(f"Lane: {session.get('lane_root')}")
    print(f"Target: {session.get('target')}")
    if session.get("dtd_uri"):
        print(f"DTD: {session.get('dtd_uri')}")
    if session.get("app_uri"):
        print(f"App: {session.get('app_uri')}")
    api = session.get("api") or {}
    if api.get("connection_domain"):
        print(f"Connection Domain: {api.get('connection_domain')}")
    if api.get("base_url"):
        print(f"API: {api.get('base_url')}")
    if api.get("login_email") or api.get("login_password"):
        print(f"Login: {api.get('login_email')} / {api.get('login_password')}")
    if session.get("last_error"):
        print(f"Error: {session.get('last_error')}")
available = payload.get("available_devices") or []
if available:
    print("Available:")
    for device in available:
        reservation = device.get("reservation_path") or "-"
        print(f"{device.get('device_id')}\t{device.get('name')}\t{device.get('state')}\t{reservation}")
if not payload.get("ok", True):
    raise SystemExit(1)
PY
}

case "$COMMAND" in
  devices)
    RESPONSE="$(request GET /devices)"
    ;;
  session)
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for session" >&2
      exit 64
    fi
    ENCODED_DEVICE_ID="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request GET "/session?device_id=$ENCODED_DEVICE_ID")"
    ;;
  reserve)
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for reserve" >&2
      exit 64
    fi
    log_progress "Requesting runtime info for $DEVICE_ID_ARG. The broker will bootstrap the lane if it is not already running."
    BODY="$(python3 -c 'import json, sys; print(json.dumps({"device_id": sys.argv[1]}))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request POST /reserve "$BODY")"
    ;;
  reboot)
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for reboot" >&2
      exit 64
    fi
    log_progress "Restarting the runtime for $DEVICE_ID_ARG. Waiting for a fresh DTD session."
    BODY="$(python3 -c 'import json, sys; print(json.dumps({"device_id": sys.argv[1]}))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request POST /reboot "$BODY")"
    ;;
  *)
    cat <<'EOF'
Usage:
  flutter-sim devices [--json]
  flutter-sim session --device-id <id> [--json]
  flutter-sim reserve --device-id <id> [--json]
  flutter-sim reboot --device-id <id> [--json]
EOF
    exit 64
    ;;
esac

if [[ "$JSON" -eq 1 ]]; then
  render "$RESPONSE" json
else
  case "$COMMAND" in
    devices) render "$RESPONSE" devices ;;
    session) render "$RESPONSE" session ;;
    *) render "$RESPONSE" op ;;
  esac
fi
