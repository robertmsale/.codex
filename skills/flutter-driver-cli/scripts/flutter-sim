#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-}"
shift || true

show_help() {
  cat <<'EOF'
Usage:
  flutter-sim devices [--json]
  flutter-sim reserve --device-id <id> [--json]
  flutter-sim reboot --device-id <id> [--json]
  flutter-sim dump-logs --device-id <id> [--json]

Deprecated:
  The managed QA harness / Flutter simulator broker is no longer the active
  Robdex QA workflow. QA agents should use an assigned worktree and assigned
  device UDID with designer-runtime tooling:

    designer-flutter-run --session <name> --device-id <UDID> --workdir <worktree>
    designer-drive hierarchy --device-id <UDID>
    designer-drive screenshot --device-id <UDID> --out current.png

Compatibility:
  `flutter-sim devices` delegates to `designer-drive devices` as a convenience.
  `reserve`, `reboot`, and `dump-logs` no longer manage broker-owned runtimes.
EOF
}

deprecated_managed_command() {
  local legacy_command="$1"
  echo "flutter-sim $legacy_command is deprecated: managed QA harness runtime control is disabled." >&2
  echo "Use an assigned worktree and device UDID with designer-flutter-run and designer-drive." >&2
  exit 2
}

case "$command_name" in
  -h|--help|"")
    show_help
    ;;
  devices)
    if [[ "${1:-}" == "--json" ]]; then
      shift
      exec designer-drive --json devices "$@"
    fi
    exec designer-drive devices "$@"
    ;;
  reserve|reboot|dump-logs)
    deprecated_managed_command "$command_name"
    ;;
  *)
    echo "Unknown flutter-sim command: $command_name" >&2
    show_help >&2
    exit 64
    ;;
esac
