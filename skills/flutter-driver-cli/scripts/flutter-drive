#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${FLUTTER_DRIVE_SERVER_BASE_URL:-${FLUTTER_SIM_DRIVE_SERVER_BASE_URL:-http://127.0.0.1:8768}}"
COMMAND="${1:-}"
shift || true

DEVICE_ID_ARG=""
JSON=0
OUT_PATH=""
INPUT_JSON=""
LABEL=""
SCREENSHOT_ROOT="/tmp/flutter-driver-screenshots"

normalize_device_id() {
  local value="$1"
  if [[ "$value" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    printf '%s' "$value" | tr '[:lower:]' '[:upper:]'
  else
    printf '%s' "$value"
  fi
}

normalize_screenshot_out_path() {
  local device_id="$1"
  local requested_path="$2"
  local image_name
  image_name="$(basename "$requested_path")"
  if [[ -z "$image_name" || "$image_name" == "." || "$image_name" == ".." ]]; then
    echo "Invalid screenshot image name." >&2
    exit 64
  fi
  OUT_PATH="${SCREENSHOT_ROOT}/${device_id}/${image_name}"
}

request() {
  local method="$1"
  local endpoint="$2"
  local body="$3"
  curl -fsS -X "$method" -H 'Content-Type: application/json' "$BASE_URL$endpoint" -d "$body"
}

render() {
  local payload="$1"
  local mode="$2"
  local payload_file
  payload_file="$(mktemp)"
  printf '%s' "$payload" > "$payload_file"
  python3 - "$mode" "$OUT_PATH" "$payload_file" <<'PY'
import base64
import json
import sys
from pathlib import Path

mode = sys.argv[1]
out_path = sys.argv[2]
payload_path = Path(sys.argv[3])
payload = json.loads(payload_path.read_text())

if mode == "json":
    print(json.dumps(payload, separators=(",", ":")))
    raise SystemExit(0 if payload.get("ok", True) else 1)

if not payload.get("ok", True):
    message = payload.get("message") or "Request failed."
    if payload.get("stderr"):
        message = f"{message}\n{payload['stderr']}"
    elif payload.get("stdout"):
        message = f"{message}\n{payload['stdout']}"
    print(message, file=sys.stderr)
    raise SystemExit(1)

if mode == "apps":
    for app in payload.get("apps") or []:
        print(f"{app.get('name','-')}\t{app.get('appId','-')}")
    raise SystemExit(0)

def parse_driver_hierarchy(raw: str):
    raw = (raw or "").strip()
    if not raw:
        return None
    start = raw.find("[")
    if start == -1:
        start = raw.find("{")
    if start == -1:
        return None
    return json.loads(raw[start:])

def compact_idb_element(element):
    label = (element.get("AXLabel") or "").strip()
    value = element.get("AXValue")
    unique_id = (element.get("AXUniqueId") or "").strip()
    role = (element.get("role_description") or element.get("type") or "").strip()
    frame = element.get("frame") or {}
    try:
        left = int(round(float(frame.get("x", 0))))
        top = int(round(float(frame.get("y", 0))))
        width = int(round(float(frame.get("width", 0))))
        height = int(round(float(frame.get("height", 0))))
    except Exception:
        left = top = width = height = 0
    right = left + width
    bottom = top + height

    primary = label or (value.strip() if isinstance(value, str) and value.strip() else "") or unique_id or role or "<node>"
    parts = [primary]
    if unique_id:
        parts.append(f"id=`{unique_id}`")
    if isinstance(value, str) and value.strip() and value.strip() != primary:
        parts.append(f"value={json.dumps(value)}")
    if role and role.casefold() not in primary.casefold():
        parts.append(f"role={json.dumps(role)}")
    if element.get("enabled") is False:
        parts.append("[disabled]")
    parts.append(f"[{left},{top}][{right},{bottom}]")
    return "- " + " ".join(parts)

def compact_idb_hierarchy_lines(raw: str):
    parsed = parse_driver_hierarchy(raw)
    if not isinstance(parsed, list):
        return raw, []
    lines = []
    for element in parsed:
        if not isinstance(element, dict):
            continue
        if (element.get("AXLabel") or "").strip() == "keyboard-frame":
            continue
        lines.append(compact_idb_element(element))
    return parsed, lines

if mode == "hierarchy":
    raw = payload.get("hierarchy", "")
    parsed, lines = compact_idb_hierarchy_lines(raw)
    if not isinstance(parsed, list):
        print(raw)
        raise SystemExit(0)
    print("\n".join(lines))
    raise SystemExit(0)

if mode == "screenshot":
    data = payload.get("data_base64")
    if not data:
        print("Screenshot response did not include image data.", file=sys.stderr)
        raise SystemExit(1)
    target = out_path or payload.get("path")
    if not target:
        print("Screenshot response did not include an output path.", file=sys.stderr)
        raise SystemExit(1)
    path = Path(target)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(base64.b64decode(data))
    print(str(path))
    raise SystemExit(0)

if mode == "flow":
    for artifact in payload.get("artifacts") or []:
        print(artifact)
    raise SystemExit(0)

if mode == "op":
    tapped = payload.get("tapped_description")
    post_hierarchy = payload.get("post_hierarchy")
    if isinstance(tapped, str) and tapped:
        print(f"Tapped: {tapped}")
    if isinstance(post_hierarchy, str) and post_hierarchy:
        _parsed, lines = compact_idb_hierarchy_lines(post_hierarchy)
        if lines:
            print("\n".join(lines))
            raise SystemExit(0)

print(payload.get("message", ""))
PY
  local status=$?
  rm -f "$payload_file"
  return $status
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device-id)
      DEVICE_ID_ARG="$2"
      shift 2
      ;;
    --json)
      JSON=1
      shift
      ;;
    --input)
      INPUT_JSON="$2"
      shift 2
      ;;
    --label)
      LABEL="$2"
      shift 2
      ;;
    --out)
      OUT_PATH="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ -n "$DEVICE_ID_ARG" ]]; then
  DEVICE_ID_ARG="$(normalize_device_id "$DEVICE_ID_ARG")"
fi

case "$COMMAND" in
  apps)
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for apps" >&2
      exit 64
    fi
    BODY="$(python3 -c 'import json, sys; print(json.dumps({"device_id": sys.argv[1]}))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request POST /maestro/apps "$BODY")"
    MODE="apps"
    ;;
  hierarchy|widget-tree)
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for hierarchy" >&2
      exit 64
    fi
    BODY="$(python3 -c 'import json, sys; print(json.dumps({"device_id": sys.argv[1]}))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request POST /maestro/hierarchy "$BODY")"
    MODE="hierarchy"
    ;;
  screenshot)
    if [[ -z "$DEVICE_ID_ARG" || -z "$OUT_PATH" ]]; then
      echo "--device-id and --out are required for screenshot" >&2
      exit 64
    fi
    normalize_screenshot_out_path "$DEVICE_ID_ARG" "$OUT_PATH"
    BODY="$(python3 -c 'import json, sys; print(json.dumps({"device_id": sys.argv[1], "command": "takeScreenshot", "label": "screenshot"}))' "$DEVICE_ID_ARG")"
    RESPONSE="$(request POST /maestro/command "$BODY")"
    MODE="screenshot"
    ;;
  command|driver)
    SUBCOMMAND="${1:-}"
    if [[ -z "$SUBCOMMAND" ]]; then
      echo "command requires a driver command name" >&2
      exit 64
    fi
    shift || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --device-id)
          DEVICE_ID_ARG="$2"
          shift 2
          ;;
        --input)
          INPUT_JSON="$2"
          shift 2
          ;;
        --label)
          LABEL="$2"
          shift 2
          ;;
        --out)
          OUT_PATH="$2"
          shift 2
          ;;
        *)
          echo "Unknown argument: $1" >&2
          exit 64
          ;;
      esac
    done
    if [[ -z "$DEVICE_ID_ARG" ]]; then
      echo "--device-id is required for command" >&2
      exit 64
    fi
    if [[ "$SUBCOMMAND" == "takeScreenshot" || "$SUBCOMMAND" == "screenshot" ]]; then
      if [[ -z "$OUT_PATH" ]]; then
        echo "--out is required for screenshot commands" >&2
        exit 64
      fi
      normalize_screenshot_out_path "$DEVICE_ID_ARG" "$OUT_PATH"
      SUBCOMMAND="takeScreenshot"
    fi
    BODY="$(python3 - "$DEVICE_ID_ARG" "$SUBCOMMAND" "$INPUT_JSON" "$LABEL" <<'PY'
import json
import sys

device_id, command, input_json, label = sys.argv[1:]
payload = {"device_id": device_id, "command": command}
if input_json:
    payload["input"] = json.loads(input_json)
if label:
    payload["label"] = label
print(json.dumps(payload))
PY
)"
    RESPONSE="$(request POST /maestro/command "$BODY")"
    MODE="$([[ "$SUBCOMMAND" == "takeScreenshot" ]] && printf 'screenshot' || printf 'op')"
    ;;
  flow)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --device-id)
          DEVICE_ID_ARG="$2"
          shift 2
          ;;
        --input)
          INPUT_JSON="$2"
          shift 2
          ;;
        --label)
          LABEL="$2"
          shift 2
          ;;
        *)
          echo "Unknown argument: $1" >&2
          exit 64
          ;;
      esac
    done
    if [[ -n "$DEVICE_ID_ARG" ]]; then
      DEVICE_ID_ARG="$(normalize_device_id "$DEVICE_ID_ARG")"
    fi
    if [[ -z "$DEVICE_ID_ARG" || -z "$INPUT_JSON" ]]; then
      echo "--device-id and --input are required for flow" >&2
      exit 64
    fi
    BODY="$(python3 - "$DEVICE_ID_ARG" "$INPUT_JSON" "$LABEL" <<'PY'
import json
import sys

device_id, commands_json, label = sys.argv[1:]
payload = {"device_id": device_id, "commands": json.loads(commands_json)}
if label:
    payload["label"] = label
print(json.dumps(payload))
PY
)"
    RESPONSE="$(request POST /maestro/flow "$BODY")"
    MODE="flow"
    ;;
  *)
    cat <<'EOF'
Usage:
  flutter-drive apps --device-id <id> [--json]
  flutter-drive hierarchy --device-id <id> [--json]
  flutter-drive screenshot --device-id <id> --out <image-name> [--json]
  flutter-drive command <driver-command> --device-id <id> [--input <json>] [--label <text>] [--out <image-name>] [--json]
  flutter-drive flow --device-id <id> --input <json-array> [--label <text>] [--json]
EOF
    exit 64
    ;;
esac

if [[ "$JSON" -eq 1 ]]; then
  render "$RESPONSE" json
else
  render "$RESPONSE" "$MODE"
fi
