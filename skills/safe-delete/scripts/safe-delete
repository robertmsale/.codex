#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  safe-delete <path> [path...]
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

stage_root="/tmp/safe-delete"
mkdir -p "$stage_root"

ts="$(date -u +%Y%m%dT%H%M%SZ)"
moved=0

for path in "$@"; do
  if [[ ! -e "$path" ]]; then
    echo "safe-delete: missing path: $path" >&2
    continue
  fi

  base="$(basename "$path")"
  target="${stage_root}/${base}-${ts}-${RANDOM}"
  mv -- "$path" "$target"
  echo "$path -> $target"
  moved=$((moved + 1))
done

if [[ "$moved" -eq 0 ]]; then
  exit 1
fi
