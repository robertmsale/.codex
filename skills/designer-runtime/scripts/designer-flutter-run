#!/usr/bin/env bash
set -euo pipefail

session=""
device_id=""
workdir=""
target=""
flavor=""
declare -a extra_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session)
      session="${2:-}"
      shift 2
      ;;
    --device-id)
      device_id="${2:-}"
      shift 2
      ;;
    --workdir)
      workdir="${2:-}"
      shift 2
      ;;
    --target)
      target="${2:-}"
      shift 2
      ;;
    --flavor)
      flavor="${2:-}"
      shift 2
      ;;
    --)
      shift
      extra_args=("$@")
      break
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

[[ -n "$session" ]] || { echo "--session is required" >&2; exit 2; }
[[ -n "$device_id" ]] || { echo "--device-id is required" >&2; exit 2; }
workdir="${workdir:-$PWD}"
[[ -d "$workdir" ]] || { echo "workdir does not exist: $workdir" >&2; exit 1; }

if tmux has-session -t "$session" 2>/dev/null; then
  echo "tmux session already exists: $session" >&2
  exit 1
fi

cmd=(flutter run -d "$device_id")
[[ -n "$target" ]] && cmd+=(--target "$target")
[[ -n "$flavor" ]] && cmd+=(--flavor "$flavor")
if [[ ${#extra_args[@]} -gt 0 ]]; then
  cmd+=("${extra_args[@]}")
fi

escaped_workdir="$(printf '%q' "$workdir")"
escaped_cmd="$(printf '%q ' "${cmd[@]}")"
tmux new-session -d -s "$session" "cd $escaped_workdir && ${escaped_cmd% }"
printf 'started tmux session %s in %s\n' "$session" "$workdir"
