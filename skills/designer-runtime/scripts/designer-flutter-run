#!/usr/bin/env bash
set -euo pipefail

session=""
device_id=""
workdir=""
target=""
flavor=""
log_file=""
declare -a extra_args=()

usage() {
  cat <<'EOF'
Usage:
  designer-flutter-run --session <tmux-session> --device-id <UDID> [--workdir <path>] [--target <dart-file>] [--flavor <flavor>] [--log <path>] [-- <flutter args>...]

Launches `flutter run -d <UDID>` in a tmux session from the requested workdir.
Output is also written to a log file so immediate tmux exits are diagnosable.

Defaults:
  --workdir defaults to the current directory.
  --log defaults to /tmp/designer-flutter-run/<session>.log.

After launch:
  tmux attach -t <tmux-session>
  designer-hot-reload --session <tmux-session>
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --session)
      session="${2:-}"
      shift 2
      ;;
    --device-id)
      device_id="${2:-}"
      shift 2
      ;;
    --workdir)
      workdir="${2:-}"
      shift 2
      ;;
    --target)
      target="${2:-}"
      shift 2
      ;;
    --flavor)
      flavor="${2:-}"
      shift 2
      ;;
    --log)
      log_file="${2:-}"
      shift 2
      ;;
    --)
      shift
      extra_args=("$@")
      break
      ;;
    *)
      echo "unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

[[ -n "$session" ]] || { echo "--session is required" >&2; exit 2; }
[[ -n "$device_id" ]] || { echo "--device-id is required" >&2; exit 2; }
workdir="${workdir:-$PWD}"
[[ -d "$workdir" ]] || { echo "workdir does not exist: $workdir" >&2; exit 1; }
if [[ -z "$log_file" ]]; then
  log_file="/tmp/designer-flutter-run/${session}.log"
fi
mkdir -p "$(dirname "$log_file")"

if tmux has-session -t "$session" 2>/dev/null; then
  echo "tmux session already exists: $session" >&2
  exit 1
fi

cmd=(flutter run -d "$device_id")
[[ -n "$target" ]] && cmd+=(--target "$target")
[[ -n "$flavor" ]] && cmd+=(--flavor "$flavor")
if [[ ${#extra_args[@]} -gt 0 ]]; then
  cmd+=("${extra_args[@]}")
fi

run_root="/tmp/designer-flutter-run"
mkdir -p "$run_root"
runner="$run_root/${session}.sh"
escaped_cmd="$(printf '%q ' "${cmd[@]}")"
cat >"$runner" <<EOF
#!/bin/bash
set -o pipefail
cd "$(printf '%q' "$workdir")" || exit 1
{
  printf '[designer-flutter-run] session: %s\n' "$(printf '%q' "$session")"
  printf '[designer-flutter-run] workdir: %s\n' "$(printf '%q' "$workdir")"
  printf '[designer-flutter-run] device: %s\n' "$(printf '%q' "$device_id")"
  printf '[designer-flutter-run] command: %s\n' "$(printf '%q' "${cmd[0]}") ${escaped_cmd#* }"
  printf '[designer-flutter-run] flutter path: '
  command -v flutter || true
  printf '[designer-flutter-run] started at: %s\n' "\$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  ROBDEX_DESIGNER_FLUTTER_RUN=1 ${escaped_cmd% }
  status=\$?
  printf '\n[designer-flutter-run] flutter exited with status %s\n' "\$status"
  exit "\$status"
} 2>&1 | tee "$(printf '%q' "$log_file")"
exit "\${PIPESTATUS[0]}"
EOF
chmod +x "$runner"

tmux new-session -d -s "$session" -c "$workdir"
tmux send-keys -t "$session" "$runner" C-m

for _ in {1..20}; do
  if [[ -s "$log_file" ]]; then
    break
  fi
  sleep 0.1
done

if [[ ! -s "$log_file" ]]; then
  {
    printf '[designer-flutter-run] tmux session started but log stayed empty.\n'
    printf '[designer-flutter-run] runner: %s\n' "$runner"
    printf '[designer-flutter-run] pane:\n'
    tmux capture-pane -p -t "$session" -S -80 2>/dev/null || true
  } >"$log_file"
fi
printf 'started tmux session %s in %s\n' "$session" "$workdir"
printf 'log file: %s\n' "$log_file"
