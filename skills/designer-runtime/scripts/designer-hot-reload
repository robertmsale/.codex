#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || "$1" != "--session" ]]; then
  cat >&2 <<'EOF'
Usage:
  designer-hot-reload --session <tmux_session>
EOF
  exit 2
fi

session="$2"
tmux has-session -t "$session" 2>/dev/null || {
  echo "tmux session not found: $session" >&2
  exit 1
}

tmux send-keys -t "$session" r
printf 'sent hot reload to %s\n' "$session"
