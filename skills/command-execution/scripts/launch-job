#!/bin/bash
set -euo pipefail

source $HOME/.profile

try_activate_codex_root() {
  local activate_script="$HOME/.codex/activate"
  local codex_root="${1:-}"
  [[ -f "$activate_script" ]] || return 0
  [[ -n "$codex_root" && -d "$codex_root/skills" ]] || return 0
  source "$activate_script" "$codex_root" >/dev/null 2>&1 || true
}

resolve_agent_codex_root_from_bridge() {
  local thread_id="${CODEX_THREAD_ID:-}"
  local bridge_base_url="${ROBDEX_BRIDGE_BASE_URL:-http://127.0.0.1:42080}"
  local whoami_url=""
  local payload=""
  local cwd=""

  [[ -n "$thread_id" ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  whoami_url="${bridge_base_url%/}/orchestrator/whoami?threadId=${thread_id}"
  if ! payload="$(curl -fsS --max-time 2 "$whoami_url" 2>/dev/null)"; then
    return 0
  fi

  if ! cwd="$(python3 -c 'import json,sys; data=json.loads(sys.stdin.read()); print(data.get("cwd",""))' <<<"$payload" 2>/dev/null)"; then
    return 0
  fi

  [[ -n "$cwd" ]] || return 0
  printf '%s/.codex\n' "$cwd"
}

# Best-effort PATH layering:
# 1. Always try global ~/.codex skill scripts.
# 2. Then try bridge-authoritative agent cwd local skill scripts when present.
# 3. Finally, still honor AGENT_CWD as a fallback hint when present.
try_activate_codex_root "$HOME/.codex"
if agent_codex_root="$(resolve_agent_codex_root_from_bridge)"; then
  if [[ -n "${agent_codex_root:-}" ]]; then
    try_activate_codex_root "$agent_codex_root"
  fi
fi
if [[ -n "${AGENT_CWD:-}" ]]; then
  try_activate_codex_root "${AGENT_CWD}/.codex"
fi

strip_shim_path() {
  local path_value="${1:-}"
  local shim_dir="/opt/homebrew/shim"
  local rebuilt=""
  local entry=""
  local old_ifs="$IFS"
  IFS=':'
  for entry in $path_value; do
    [[ -z "$entry" || "$entry" == "$shim_dir" ]] && continue
    if [[ -n "$rebuilt" ]]; then
      rebuilt="${rebuilt}:$entry"
    else
      rebuilt="$entry"
    fi
  done
  IFS="$old_ifs"
  printf '%s\n' "$rebuilt"
}

swap_home_users_prefix() {
  local path_value="${1:-}"
  case "$path_value" in
    /home/*)
      printf '/Users/%s\n' "${path_value#/home/}"
      ;;
    /Users/*)
      printf '/home/%s\n' "${path_value#/Users/}"
      ;;
    *)
      printf '%s\n' "$path_value"
      ;;
  esac
}

normalize_cwd_alias() {
  local current="${PWD:-}"
  local alternate=""
  [[ -n "$current" ]] || return 0

  if [[ ! -d "$current" ]]; then
    alternate="$(swap_home_users_prefix "$current")"
    if [[ "$alternate" != "$current" && -d "$alternate" ]]; then
      cd "$alternate"
      return 0
    fi
  fi

  case "$current" in
    /home/*|/Users/*)
      alternate="$(swap_home_users_prefix "$current")"
      if [[ "$alternate" != "$current" && -d "$alternate" ]]; then
        # Prefer the mirrored alias path so commands behave consistently across
        # macOS/VM sessions that bounce between /Users and /home.
        cd "$alternate"
      fi
      ;;
  esac
}

passthru_activation_prefix() {
  cat <<'EOF'
if [[ -f "$HOME/.codex/activate" ]]; then
  source "$HOME/.codex/activate" "$HOME/.codex" >/dev/null 2>&1 || true

  if [[ -n "${CODEX_THREAD_ID:-}" ]] && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    __robdex_bridge_base_url="${ROBDEX_BRIDGE_BASE_URL:-http://127.0.0.1:42080}"
    __robdex_payload="$(curl -fsS --max-time 2 "${__robdex_bridge_base_url%/}/orchestrator/whoami?threadId=${CODEX_THREAD_ID}" 2>/dev/null || true)"
    if [[ -n "${__robdex_payload:-}" ]]; then
      __robdex_cwd="$(python3 -c 'import json,sys; data=json.loads(sys.stdin.read()); print(data.get("cwd",""))' <<<"${__robdex_payload}" 2>/dev/null || true)"
      if [[ -n "${__robdex_cwd:-}" && -d "${__robdex_cwd}/.codex/skills" ]]; then
        source "$HOME/.codex/activate" "${__robdex_cwd}/.codex" >/dev/null 2>&1 || true
      fi
    fi
    unset __robdex_bridge_base_url __robdex_payload __robdex_cwd
  fi

  if [[ -n "${AGENT_CWD:-}" && -d "${AGENT_CWD}/.codex/skills" ]]; then
    source "$HOME/.codex/activate" "${AGENT_CWD}/.codex" >/dev/null 2>&1 || true
  fi
fi

case ":${PATH:-}:" in
  *:/usr/local/bin:*)
    ;;
  *)
    export PATH="${PATH:+${PATH}:}/usr/local/bin"
    ;;
esac
EOF
}

usage() {
  cat <<'EOF'
Usage:
  launch-job <command> [args...]
  launch-job -lc "<command string>"
  launch-job -c "<command string>"
EOF
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "${LAUNCH_JOB_PASSTHRU:-0}" == "1" ]]; then
  export PATH="$(strip_shim_path "${PATH:-}")"
  case ":${PATH:-}:" in
    *:/usr/local/bin:*)
      ;;
    *)
      export PATH="${PATH:+${PATH}:}/usr/local/bin"
      ;;
  esac
  if [[ "${1:-}" == "-lc" || "${1:-}" == "-c" ]]; then
    mode="$1"
    shift
    if [[ $# -lt 1 ]]; then
      usage >&2
      exit 2
    fi
    command_text="$1"
    shift
    prefixed_command="$(passthru_activation_prefix)

${command_text}"
    exec /bin/zsh "$mode" "$prefixed_command" "$@"
  fi
  exec "$@"
fi

if [[ "${1:-}" == "-lc" || "${1:-}" == "-c" ]]; then
  mode="$1"
  shift
  if [[ $# -lt 1 ]]; then
    usage >&2
    exit 2
  fi
  shell_bin="${LAUNCH_JOB_SHELL:-/bin/zsh}"
  command_text="$1"
  shift
  prefixed_command="$(passthru_activation_prefix)

${command_text}"
  set -- "$shell_bin" "$mode" "$prefixed_command" "$@"
fi

normalize_cwd_alias

umask 077
state_root="/tmp/codex-command-jobs"
mkdir -p "$state_root"

if command -v uuidgen >/dev/null 2>&1; then
  job_id="$(uuidgen | tr '[:upper:]' '[:lower:]')"
else
  job_id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
fi

job_file="$state_root/${job_id}.job"
{
  printf 'job_id=%s\n' "$job_id"
  printf 'cwd=%s\n' "$PWD"
  printf 'started_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'launcher_pid=%s\n' "$$"
} >"$job_file"

printf 'job_id: %s\n' "$job_id" >&2

cleanup() {
  rm -f "$job_file"
}

cmd_pid=""
on_signal() {
  if [[ -n "${cmd_pid:-}" ]]; then
    kill -TERM "$cmd_pid" 2>/dev/null || true
    wait "$cmd_pid" 2>/dev/null || true
  fi
  cleanup
  exit 130
}

trap on_signal HUP INT TERM
trap 'cleanup' EXIT

PATH="$(strip_shim_path "${PATH:-}")" LAUNCH_JOB_PASSTHRU=1 "$@" &
cmd_pid=$!

{
  printf 'cmd_pid=%s\n' "$cmd_pid"
} >>"$job_file"

if wait "$cmd_pid"; then
  exit 0
else
  exit $?
fi
