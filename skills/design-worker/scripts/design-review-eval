#!/usr/bin/env bash
set -euo pipefail

eval_root="/Users/robertsale/.codex/skills/design-worker/assets/evals"

usage() {
  cat >&2 <<'EOF'
Usage:
  design-review-eval [--all]
  design-review-eval <case-id>
  design-review-eval --list
  design-review-eval --show-expected <case-id|--all>

Runs the design-review agent against curated visual eval cases.

Case IDs:
  A1 A2 A3 A4 D1 D2 D3 S1 S2 S3 X1 X2

The harness uses the actual Ref/Actual image pair and a case-specific product
intent context. It does not use screenshot-diff heuristics.

By default, calibration expectations are not printed. Use `--show-expected`
only when comparing evaluator output after the review has run.
EOF
}

case_context() {
  case "$1" in
    A1) cat <<'EOF'
Scope: Content Audit project page, including the visible application shell.
EOF
      ;;
    A2) cat <<'EOF'
Scope: Data Sync workflow page, including the visible application shell.
EOF
      ;;
    A3) cat <<'EOF'
Scope: Launch Campaign project page, including the visible application shell.
EOF
      ;;
    A4) cat <<'EOF'
Scope: Redesign homepage hero task detail page, including the visible application shell.
EOF
      ;;
    D1) cat <<'EOF'
Scope: Northwind business overview dashboard, including the visible application shell.
EOF
      ;;
    D2) cat <<'EOF'
Scope: Northwind Analytics overview dashboard, including the visible application shell.
EOF
      ;;
    D3) cat <<'EOF'
Scope: Northwind Analytics dark dashboard overview, including the visible application shell.
EOF
      ;;
    S1) cat <<'EOF'
Scope: Acme Website Redesign project page and application shell.
EOF
      ;;
    S2) cat <<'EOF'
Scope: ACME Website Redesign project page and application shell.
EOF
      ;;
    S3) cat <<'EOF'
Scope: Acme Website Redesign project page and application shell.
EOF
      ;;
    X1) cat <<'EOF'
Scope: ServiceFlow repair work-order page for "Repair - AC Unit Not Cooling," including the visible application shell.
EOF
      ;;
    X2) cat <<'EOF'
Scope: Nexus Orion Expansion Initiative overview dashboard, including the visible application shell.
EOF
      ;;
    *) return 1 ;;
  esac
}

case_expectation() {
  case "$1" in
    A1) echo "Expected: FAIL. Catastrophic dashboardification, AI slop, semantic pollution." ;;
    A2) echo "Expected: FAIL. Severe semantic/dev contamination despite plausible layout." ;;
    A3) echo "Expected: BORDERLINE. Medium-quality operational page; critique proportionally." ;;
    A4) echo "Expected: PASS. Tasteful improvement over a reasonable reference." ;;
    D1) echo "Expected: FAIL. Fake analytics dashboard with dev notes/placeholders." ;;
    D2) echo "Expected: FAIL/BORDERLINE. Useful density but cluttered and semantically polluted." ;;
    D3) echo "Expected: PASS. Near-perfect dashboard; no invented major criticism." ;;
    S1) echo "Expected: FAIL. Shell dominates and contaminates the workflow." ;;
    S2) echo "Expected: FAIL/BORDERLINE. Subtle but meaningful shell style drift." ;;
    S3) echo "Expected: PASS. Tasteful shell refinement." ;;
    X1) echo "Expected: FAIL. Operational page misclassified as dashboard." ;;
    X2) echo "Expected: PASS. Reference is flawed; actual is principled improvement." ;;
    *) return 1 ;;
  esac
}

case_ids=(A1 A2 A3 A4 D1 D2 D3 S1 S2 S3 X1 X2)

show_expected=0
if [[ "${1:-}" == "--show-expected" ]]; then
  show_expected=1
  shift
fi

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--list" ]]; then
  printf '%s\n' "${case_ids[@]}"
  exit 0
fi

if [[ "${1:-}" == "--all" ]]; then
  selected=("${case_ids[@]}")
else
  selected=("$1")
fi

for case_id in "${selected[@]}"; do
  if ! context="$(case_context "$case_id")"; then
    echo "design-review-eval: unknown case: $case_id" >&2
    exit 2
  fi

  reference="$eval_root/$case_id-Ref.png"
  actual="$eval_root/$case_id-Actual.png"
  if [[ ! -f "$reference" || ! -f "$actual" ]]; then
    echo "design-review-eval: missing image pair for $case_id" >&2
    exit 2
  fi

  echo "===== $case_id ====="
  DESIGN_REVIEW_TIMEOUT_SECONDS="${DESIGN_REVIEW_TIMEOUT_SECONDS:-300}" \
    design-review "$reference" "$actual" "$context"
  if [[ "$show_expected" -eq 1 ]]; then
    echo
    echo "Calibration target, not sent to reviewer:"
    case_expectation "$case_id"
  fi
  echo
done
