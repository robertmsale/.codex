#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  request-review [--use-existing-commit] [--existing-commit <sha-or-ref>] <commit-message>

Examples:
  request-review "fix: address codex review"
  request-review "chore: review checkpoint"
  request-review --use-existing-commit "fix: rerun review for current HEAD"
  request-review --use-existing-commit --existing-commit HEAD~1 "fix: review prior commit"

USAGE
}

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "request-review: missing required command: $cmd" >&2
    exit 1
  }
}

emit_result() {
  local message="$1"
  printf '%s\n' "$message"
}

gitops_http_base_url() {
  printf '%s\n' "${PARALLELS_SYNC_GITOPS_BASE_URL:-http://host.internal:8765}"
}

json_build_request() {
  python3 - <<'PY' "$@"
import json
import sys

payload = {"args": {}}
for item in sys.argv[1:]:
    key, value = item.split("=", 1)
    if value.startswith("json:"):
        payload["args"][key] = json.loads(value[5:])
    elif value in {"true", "false"}:
        payload["args"][key] = value == "true"
    else:
        payload["args"][key] = value
print(json.dumps(payload))
PY
}

host_review_via_bridge() {
  local repo_path="$1"
  local title="$2"
  local profile="$3"
  local mode="$4"
  local commit_ref="${5:-}"

  require_cmd curl

  local payload_args=(
    "repo_path=$repo_path"
    "title=$title"
    "profile=$profile"
  )
  if [[ "$mode" == "uncommitted" ]]; then
    payload_args+=("uncommitted=true")
  else
    payload_args+=("uncommitted=false" "commit_ref=$commit_ref")
  fi

  local payload
  payload="$(json_build_request "${payload_args[@]}")"

  local response
  response="$(curl -fsS -H 'Content-Type: application/json' -d "$payload" "$(gitops_http_base_url)/v1/ops/request_host_review")"

  python3 - <<'PY' "$response"
import json
import sys

data = json.loads(sys.argv[1])
result = data.get("result") or {}
message = (result.get("message") or "").strip()
exit_code = int(result.get("exit_code") or 0)
print(message)
raise SystemExit(exit_code)
PY
}

host_review_direct() {
  local repo_root="$1"
  local title="$2"
  local profile="$3"
  local output_path="$4"
  local error_path="$5"
  local mode="$6"
  local commit_ref="${7:-}"

  local cmd=(
    codex exec review
    --output-last-message "$output_path"
    -C "$repo_root"
    -s read-only
    -p "$profile"
    --title "$title"
  )

  if [[ "$mode" == "uncommitted" ]]; then
    cmd+=(--uncommitted)
  else
    cmd+=(--commit "$commit_ref")
  fi

  : >"$error_path"
  if "${cmd[@]}" > /dev/null 2>"$error_path"; then
    return 0
  fi
  return $?
}

remote_terminal_error_comment_json() {
  local issue_comments_json="$1"

  jq -c '
    map(select(((.body // "") | startswith("Codex Review: Something went wrong."))))
    | sort_by(.created_at)
    | last // empty
  ' <<<"$issue_comments_json"
}

remote_contains_commit() {
  local commit_sha="$1"
  local remote_tip_sha="$2"

  if [[ -z "$remote_tip_sha" ]]; then
    return 1
  fi
  if [[ "$commit_sha" == "$remote_tip_sha" ]]; then
    return 0
  fi

  git merge-base --is-ancestor "$commit_sha" "$remote_tip_sha" >/dev/null 2>&1
}

remote_is_ancestor_of_commit() {
  local remote_tip_sha="$1"
  local commit_sha="$2"

  if [[ -z "$remote_tip_sha" ]]; then
    return 1
  fi
  if [[ "$remote_tip_sha" == "$commit_sha" ]]; then
    return 0
  fi

  git merge-base --is-ancestor "$remote_tip_sha" "$commit_sha" >/dev/null 2>&1
}

push_review_target() {
  local review_sha="$1"
  local branch_name="$2"
  local remote_branch_sha="${3:-}"
  local head_sha
  local branch_refspec

  if remote_contains_commit "$review_sha" "$remote_branch_sha"; then
    return
  fi

  head_sha="$(git rev-parse --verify HEAD)"
  if [[ "$review_sha" == "$head_sha" ]]; then
    if remote_is_ancestor_of_commit "$remote_branch_sha" "$head_sha"; then
      git push -u origin HEAD
    else
      git push --force-with-lease="refs/heads/${branch_name}:${remote_branch_sha}" origin "HEAD:refs/heads/${branch_name}"
      git branch --set-upstream-to="origin/${branch_name}" >/dev/null 2>&1 || true
    fi
    return
  fi

  branch_refspec="${review_sha}:refs/heads/${branch_name}"
  if remote_is_ancestor_of_commit "$remote_branch_sha" "$review_sha"; then
    git push origin "$branch_refspec"
  else
    git push --force-with-lease="refs/heads/${branch_name}:${remote_branch_sha}" origin "$branch_refspec"
  fi
}

persist_review_result() {
  local message="$1"

  mkdir -p "$(dirname "$review_log_path")"
  printf '%s\n' "$message" >"$review_log_path"

  if [[ "$local_output_path" != "$review_log_path" ]]; then
    mkdir -p "$(dirname "$local_output_path")"
    printf '%s\n' "$message" >"$local_output_path"
  fi
}

clear_review_result() {
  rm -f "$review_log_path"

  if [[ "$local_output_path" != "$review_log_path" ]]; then
    rm -f "$local_output_path"
  fi
}

cleanup_request_review_runtime() {
  rm -f "${local_tmp_output_path:-}" 2>/dev/null || true
  rm -f "${local_error_path:-}" 2>/dev/null || true
}

load_operator_env() {
  local env_file="$1"

  unset REQUEST_REVIEW_MODE
  unset REQUEST_REVIEW_BOT_LOGIN
  unset REQUEST_REVIEW_TRIGGER_COMMENT
  unset REQUEST_REVIEW_POLL_INTERVAL_SECONDS
  unset REQUEST_REVIEW_DISABLE
  unset REQUEST_REVIEW_LOCAL_PROFILE
  unset REQUEST_REVIEW_LOCAL_OUTPUT_FILE
  unset REQUEST_REVIEW_LOCAL_ERROR_FILE
  unset REQUEST_REVIEW_LOCAL_KEEP_DEBUG_LOGS
  unset REQUEST_REVIEW_INTEGRATION_BRANCHES

  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

resolve_operator_env_file() {
  local canonical_codex_home="$1"
  local canonical_env_file="$canonical_codex_home/skills/request-review/.env"
  printf '%s\n' "$canonical_env_file"
}

cli_use_existing_commit_flag=""
cli_existing_commit_sha_ref=""
commit_message_parts=()
parsing_options=1

while [[ $# -gt 0 ]]; do
  if [[ "$parsing_options" == "0" ]]; then
    commit_message_parts+=("$1")
    shift
    continue
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --use-existing-commit)
      cli_use_existing_commit_flag="1"
      shift
      ;;
    --existing-commit)
      if [[ $# -lt 2 ]]; then
        echo "request-review: --existing-commit requires a sha or ref" >&2
        exit 2
      fi
      cli_use_existing_commit_flag="1"
      cli_existing_commit_sha_ref="$2"
      shift 2
      ;;
    --)
      parsing_options=0
      shift
      ;;
    *)
      parsing_options=0
      commit_message_parts+=("$1")
      shift
      ;;
  esac
done

if [[ ${#commit_message_parts[@]} -lt 1 ]]; then
  usage
  exit 2
fi

commit_message="${commit_message_parts[*]}"
if [[ -z "$commit_message" ]]; then
  echo "request-review: commit message cannot be empty" >&2
  exit 2
fi

require_cmd codex
require_cmd python3

working_path="$(pwd -P)"
bridge_review_mode=0
if [[ "$working_path" == /home/* ]]; then
  bridge_review_mode=1
fi

repo_root=""
if [[ "$bridge_review_mode" == "0" ]]; then
  require_cmd git
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -z "$repo_root" ]]; then
    echo "request-review: must run inside a git repository" >&2
    exit 2
  fi
else
  repo_root="$working_path"
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
skill_dir="$(cd "$script_dir/.." && pwd)"
canonical_codex_home="$(cd "$skill_dir/../.." && pwd)"
load_operator_env "$(resolve_operator_env_file "$canonical_codex_home")"

review_mode="${REQUEST_REVIEW_MODE:-host}"
if [[ "$review_mode" == "local" ]]; then
  review_mode="host"
fi
bot_login="${REQUEST_REVIEW_BOT_LOGIN:-chatgpt-codex-connector[bot]}"
poll_interval_seconds="${REQUEST_REVIEW_POLL_INTERVAL_SECONDS:-20}"
trigger_comment="${REQUEST_REVIEW_TRIGGER_COMMENT:-@codex review}"
review_disable="${REQUEST_REVIEW_DISABLE:-0}"
local_profile="${REQUEST_REVIEW_LOCAL_PROFILE:-local-review}"
local_output_file="${REQUEST_REVIEW_LOCAL_OUTPUT_FILE:-review.log}"
local_keep_debug_logs="${REQUEST_REVIEW_LOCAL_KEEP_DEBUG_LOGS:-0}"
review_log_path="$repo_root/review.log"
local_output_path="$repo_root/$local_output_file"
tmp_root="${TMPDIR:-/tmp}"
mkdir -p "$tmp_root"
local_error_path="$(mktemp "${tmp_root%/}/request-review.error.XXXXXX")"
local_tmp_output_path="$(mktemp "${tmp_root%/}/request-review.output.XXXXXX")"

use_existing_commit_flag="0"
existing_commit_sha_ref="HEAD"
if [[ -n "$cli_use_existing_commit_flag" ]]; then
  use_existing_commit_flag="$cli_use_existing_commit_flag"
fi
if [[ -n "$cli_existing_commit_sha_ref" ]]; then
  existing_commit_sha_ref="$cli_existing_commit_sha_ref"
fi

remote_pr_number=""
remote_pr_state=""
remote_review_started_at=""
remote_branch_sha=""
remote_default_branch=""
should_push_review_sha=0
clear_review_result
cd "$repo_root"

echo "request-review: use the command-execution mcp to await review results"
echo "request-review: do not poll stdin, do not kill the review, and do not treat a long-running cloud review as hung"

branch_name=""
if [[ "$bridge_review_mode" == "0" ]]; then
  branch_name="$(git rev-parse --abbrev-ref HEAD)"
  integration_branches_raw="${REQUEST_REVIEW_INTEGRATION_BRANCHES:-main master staging prod production}"
  for protected_branch in $integration_branches_raw; do
    if [[ "$branch_name" == "$protected_branch" ]]; then
      echo "request-review: refusing to run on protected integration branch '$branch_name'" >&2
      echo "request-review: switch to an issue/feature branch before requesting review" >&2
      exit 2
    fi
  done
fi

trap cleanup_request_review_runtime EXIT HUP INT TERM

if [[ "$review_disable" != "0" ]]; then
  persist_review_result "all clear!"
  emit_result "all clear!"
  exit 0
fi

if [[ "$review_mode" == "remote" ]]; then
  if [[ "$bridge_review_mode" != "0" ]]; then
    echo "request-review: remote review is not supported from VM shadow worktrees; use host review" >&2
    exit 2
  fi

  require_cmd gh
  require_cmd jq

  git fetch -q origin "refs/heads/$branch_name:refs/remotes/origin/$branch_name" 2>/dev/null || true
  remote_pr_number="$(gh pr view --json number --jq '.number' 2>/dev/null || true)"
  if [[ -n "$remote_pr_number" ]]; then
    remote_pr_state="$(gh pr view --json state --jq '.state' 2>/dev/null || true)"
  fi
  remote_branch_sha="$(git rev-parse --verify "refs/remotes/origin/$branch_name" 2>/dev/null || true)"
  if [[ -z "$remote_branch_sha" ]]; then
    remote_branch_sha="$(git ls-remote --heads origin "refs/heads/$branch_name" 2>/dev/null | awk 'NR==1 {print $1}')"
  fi
  remote_default_branch="$(gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || true)"

  if [[ "$use_existing_commit_flag" != "0" ]]; then
    review_sha="$(git rev-parse --verify "${existing_commit_sha_ref}^{commit}" 2>/dev/null || true)"
    if [[ -z "$review_sha" ]]; then
      echo "request-review: existing commit ref is not a valid commit: $existing_commit_sha_ref" >&2
      exit 2
    fi
    if [[ "$remote_branch_sha" != "$review_sha" ]]; then
      should_push_review_sha=1
    fi
  else
    git add -A
    if git diff --cached --quiet; then
      review_sha="$(git rev-parse --verify HEAD)"
      use_existing_commit_flag="1"
      if [[ "$remote_branch_sha" != "$review_sha" ]]; then
        should_push_review_sha=1
      fi
    else
      git commit -m "$commit_message"
      review_sha="$(git rev-parse --verify HEAD)"
      should_push_review_sha=1
    fi
  fi

  if [[ "$should_push_review_sha" != "0" ]]; then
    push_review_target "$review_sha" "$branch_name" "$remote_branch_sha"
  fi

  pr_number="$(gh pr view --json number,state --jq '.number' 2>/dev/null || true)"
  pr_state="$(gh pr view --json number,state --jq '.state' 2>/dev/null || true)"
  if [[ -z "$pr_number" ]]; then
    if [[ -z "$remote_default_branch" ]]; then
      emit_result "request-review (remote): no PR found for branch '$branch_name', and failed to determine the repo default branch for PR creation."
      exit 1
    fi
    if ! gh pr create --base "$remote_default_branch" --head "$branch_name" --fill >/dev/null 2>&1; then
      emit_result "request-review (remote): failed to create a PR for branch '$branch_name' against '$remote_default_branch'."
      exit 1
    fi
    pr_number="$(gh pr view --json number,state --jq '.number' 2>/dev/null || true)"
    pr_state="$(gh pr view --json number,state --jq '.state' 2>/dev/null || true)"
  fi
  if [[ "$pr_state" != "OPEN" ]]; then
    emit_result "request-review (remote): PR #$pr_number is not OPEN (state: $pr_state)."
    exit 1
  fi

  repo_name="$(gh repo view --json nameWithOwner --jq '.nameWithOwner')"
  remote_review_started_at="$(gh api --method POST "repos/$repo_name/issues/$pr_number/comments" -f body="$trigger_comment" --jq '.created_at' 2>/dev/null || true)"
  if [[ -z "$remote_review_started_at" ]]; then
    emit_result "request-review (remote): failed to post trigger comment '$trigger_comment' on PR #$pr_number"
    exit 1
  fi

  commit_timestamp=""
  for _ in $(seq 1 30); do
    commit_timestamp="$(gh api "repos/$repo_name/pulls/$pr_number/commits" --jq '.[] | select(.sha=="'"$review_sha"'") | .commit.committer.date' || true)"
    if [[ -n "$commit_timestamp" ]]; then
      break
    fi
    sleep 2
  done

  if [[ -z "$commit_timestamp" ]]; then
    if [[ "$use_existing_commit_flag" != "0" ]]; then
      emit_result "request-review (remote): commit $review_sha is not present on PR #$pr_number. If needed, rerun without --use-existing-commit so this script can push."
    else
      emit_result "request-review (remote): commit $review_sha is not present on PR #$pr_number yet."
    fi
    exit 1
  fi

  eyes_announced=0
  while true; do
    inline_json="$(gh api "repos/$repo_name/pulls/$pr_number/comments?since=$commit_timestamp" --paginate \
      --jq '[.[] | select(.user.login=="'"$bot_login"'" and (.created_at >= "'"$remote_review_started_at"'") and (.commit_id=="'"$review_sha"'" or .original_commit_id=="'"$review_sha"'")) | {id,created_at,html_url,path,line,body}]')"

    inline_count="$(jq 'length' <<<"$inline_json")"
    if [[ "$inline_count" -gt 0 ]]; then
      result_header="request-review (remote): $inline_count inline comment(s) from $bot_login on PR #$pr_number for commit $review_sha"
      result_body="$(jq -r '.[] | "- \(.html_url)\n  File: \(.path // "unknown"):\(.line // 0)\n  Comment: \(.body)\n"' <<<"$inline_json")"
      persist_review_result "${result_header}"$'\n\n'"${result_body}"
      emit_result "${result_header}"$'\n\n'"${result_body}"
      exit 0
    fi

    issue_comments_json="$(gh api "repos/$repo_name/issues/$pr_number/comments?since=$remote_review_started_at" --paginate \
      --jq '[.[] | select(.user.login=="'"$bot_login"'" and (.created_at >= "'"$remote_review_started_at"'")) | {created_at,html_url,body}]')"

    terminal_error_comment_json="$(remote_terminal_error_comment_json "$issue_comments_json")"
    if [[ -n "$terminal_error_comment_json" && "$terminal_error_comment_json" != "null" ]]; then
      result_header="request-review (remote): terminal bot error comment from $bot_login on PR #$pr_number after commit $review_sha"
      result_body="$(jq -r '"- \(.html_url // "issue-comment")\n  Comment: \(.body)\n"' <<<"$terminal_error_comment_json")"
      persist_review_result "${result_header}"$'\n\n'"${result_body}"
      emit_result "${result_header}"$'\n\n'"${result_body}"
      exit 1
    fi

    reactions_json="$(gh api "repos/$repo_name/issues/$pr_number/reactions" -H 'Accept: application/vnd.github+json' --paginate \
      --jq '[.[] | select(.user.login=="'"$bot_login"'" and (.created_at >= "'"$remote_review_started_at"'")) | {content,created_at}]')"

    eyes_reaction="$(jq 'any(.[]; .content=="eyes")' <<<"$reactions_json")"
    if [[ "$eyes_reaction" == "true" && "$eyes_announced" -eq 0 ]]; then
      echo "request-review (remote): 👀 from $bot_login detected on PR #$pr_number; review is in progress, waiting for final result..."
      eyes_announced=1
    fi

    thumbs_up="$(jq 'any(.[]; .content=="+1")' <<<"$reactions_json")"
    if [[ "$thumbs_up" == "true" ]]; then
      persist_review_result "request-review (remote): 👍 from $bot_login on PR #$pr_number after commit $review_sha"
      emit_result "request-review (remote): 👍 from $bot_login on PR #$pr_number after commit $review_sha"
      exit 0
    fi

    sleep "$poll_interval_seconds"
  done
fi

if [[ "$review_mode" != "host" ]]; then
  echo "request-review: unsupported configured review mode '$review_mode' (expected 'host' or 'remote')" >&2
  exit 2
fi

config_file="${canonical_codex_home}/config.toml"
if [[ ! -f "$config_file" ]]; then
  emit_result "request-review (host): missing config file: $config_file"
  exit 1
fi
if ! rg -q "^\[profiles\.${local_profile}\]$" "$config_file"; then
  emit_result "request-review (host): profile '$local_profile' not found in $config_file"
  exit 1
fi

review_mode_for_host=""
review_commit_ref=""
if [[ "$bridge_review_mode" != "0" ]]; then
  if [[ "$use_existing_commit_flag" != "0" ]]; then
    review_mode_for_host="commit"
    review_commit_ref="$existing_commit_sha_ref"
  else
    review_mode_for_host="uncommitted"
  fi
else
  if [[ "$use_existing_commit_flag" != "0" ]]; then
    review_sha="$(git rev-parse --verify "${existing_commit_sha_ref}^{commit}" 2>/dev/null || true)"
    if [[ -z "$review_sha" ]]; then
      echo "request-review: existing commit ref is not a valid commit: $existing_commit_sha_ref" >&2
      exit 2
    fi
    review_mode_for_host="commit"
    review_commit_ref="$review_sha"
  else
    git add -A
    if git diff --cached --quiet; then
      review_mode_for_host="commit"
      review_commit_ref="$(git rev-parse --verify HEAD)"
    else
      review_mode_for_host="commit"
      git commit -m "$commit_message"
      review_commit_ref="$(git rev-parse --verify HEAD)"
    fi
  fi
fi

if [[ "$bridge_review_mode" != "0" ]]; then
  if host_review_via_bridge "$repo_root" "$commit_message" "$local_profile" "$review_mode_for_host" "$review_commit_ref" >"$local_tmp_output_path"; then
    review_exit=0
  else
    review_exit=$?
  fi
else
  if host_review_direct "$repo_root" "$commit_message" "$local_profile" "$local_tmp_output_path" "$local_error_path" "$review_mode_for_host" "$review_commit_ref"; then
    review_exit=0
  else
    review_exit=$?
  fi
fi

if [[ ! -s "$local_tmp_output_path" ]]; then
  emit_result "request-review (host): missing review output at $local_tmp_output_path (check $local_error_path)"
  exit 1
fi

local_review_message="$(cat "$local_tmp_output_path")"
if [[ "$review_exit" -ne 0 ]]; then
  emit_result "$local_review_message"
  exit "$review_exit"
fi

persist_review_result "$local_review_message"
emit_result "$local_review_message"

if [[ "$local_keep_debug_logs" == "0" ]]; then
  rm -f "$local_tmp_output_path"
fi

exit 0
