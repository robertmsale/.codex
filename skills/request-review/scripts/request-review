#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  request-review [--use-existing-commit] [--existing-commit <sha-or-ref>] <commit-message>

Examples:
  request-review "fix: address codex review"
  request-review "chore: review checkpoint"
  request-review --use-existing-commit "fix: rerun review for current HEAD"
  request-review --use-existing-commit --existing-commit HEAD~1 "fix: review prior commit"

Optional runtime env flags:
  REQUEST_REVIEW_USE_EXISTING_COMMIT=1
    - Skip git add/commit.
    - In remote mode, also skip git push.
  REQUEST_REVIEW_EXISTING_COMMIT_SHA=<sha-or-ref>
    - Review this commit when REQUEST_REVIEW_USE_EXISTING_COMMIT=1.
    - Defaults to HEAD.
USAGE
}

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "request-review: missing required command: $cmd" >&2
    exit 1
  }
}

emit_result() {
  local message="$1"
  printf '%s\n' "$message"
}

persist_review_result() {
  local message="$1"

  mkdir -p "$(dirname "$review_log_path")"
  printf '%s\n' "$message" >"$review_log_path"

  if [[ "$local_output_path" != "$review_log_path" ]]; then
    mkdir -p "$(dirname "$local_output_path")"
    printf '%s\n' "$message" >"$local_output_path"
  fi
}

clear_review_result() {
  rm -f "$review_log_path"

  if [[ "$local_output_path" != "$review_log_path" ]]; then
    rm -f "$local_output_path"
  fi
}

extract_local_review_message() {
  local raw_jsonl_path="$1"
  local output_path="$2"

  RAW_JSONL_PATH="$raw_jsonl_path" OUTPUT_PATH="$output_path" python3 - <<'PY'
import json
import os
from pathlib import Path

raw_path = Path(os.environ["RAW_JSONL_PATH"])
out_path = Path(os.environ["OUTPUT_PATH"])

text = raw_path.read_text(encoding="utf-8", errors="replace")
message = ""
for line in text.splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        obj = json.loads(line)
    except Exception:
        continue
    if obj.get("type") != "item.completed":
        continue
    item = obj.get("item") or {}
    if item.get("type") != "agent_message":
        continue
    candidate = (item.get("text") or "").strip()
    if candidate:
        message = candidate

if not message:
    message = text.strip()

out_path.write_text(message + ("\n" if message else ""), encoding="utf-8")
PY
}

load_operator_env() {
  local env_file="$1"

  unset REQUEST_REVIEW_MODE
  unset REQUEST_REVIEW_BOT_LOGIN
  unset REQUEST_REVIEW_TRIGGER_COMMENT
  unset REQUEST_REVIEW_POLL_INTERVAL_SECONDS
  unset REQUEST_REVIEW_DISABLE
  unset REQUEST_REVIEW_LOCAL_PROFILE
  unset REQUEST_REVIEW_LOCAL_OUTPUT_FILE
  unset REQUEST_REVIEW_LOCAL_ERROR_FILE
  unset REQUEST_REVIEW_LOCAL_KEEP_DEBUG_LOGS
  unset REQUEST_REVIEW_IMAGE
  unset REQUEST_REVIEW_CODEX_VERSION

  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$env_file"
    set +a
  fi
}

cli_use_existing_commit_flag=""
cli_existing_commit_sha_ref=""
commit_message_parts=()
parsing_options=1

while [[ $# -gt 0 ]]; do
  if [[ "$parsing_options" == "0" ]]; then
    commit_message_parts+=("$1")
    shift
    continue
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --use-existing-commit)
      cli_use_existing_commit_flag="1"
      shift
      ;;
    --existing-commit)
      if [[ $# -lt 2 ]]; then
        echo "request-review: --existing-commit requires a sha or ref" >&2
        exit 2
      fi
      cli_use_existing_commit_flag="1"
      cli_existing_commit_sha_ref="$2"
      shift 2
      ;;
    --)
      parsing_options=0
      shift
      ;;
    *)
      parsing_options=0
      commit_message_parts+=("$1")
      shift
      ;;
  esac
done

if [[ ${#commit_message_parts[@]} -lt 1 ]]; then
  usage
  exit 2
fi

commit_message="${commit_message_parts[*]}"
if [[ -z "$commit_message" ]]; then
  echo "request-review: commit message cannot be empty" >&2
  exit 2
fi

require_cmd git
require_cmd codex
require_cmd python3

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$repo_root" ]]; then
  echo "request-review: must run inside a git repository" >&2
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
skill_dir="$(cd "$script_dir/.." && pwd)"
load_operator_env "$skill_dir/.env"

review_mode="${REQUEST_REVIEW_MODE:-local}"
bot_login="${REQUEST_REVIEW_BOT_LOGIN:-chatgpt-codex-connector[bot]}"
poll_interval_seconds="${REQUEST_REVIEW_POLL_INTERVAL_SECONDS:-20}"
trigger_comment="${REQUEST_REVIEW_TRIGGER_COMMENT:-@codex review}"
review_disable="${REQUEST_REVIEW_DISABLE:-0}"
local_profile="${REQUEST_REVIEW_LOCAL_PROFILE:-local-review}"
local_output_file="${REQUEST_REVIEW_LOCAL_OUTPUT_FILE:-review.log}"
local_error_file="${REQUEST_REVIEW_LOCAL_ERROR_FILE:-review.err.log}"
local_keep_debug_logs="${REQUEST_REVIEW_LOCAL_KEEP_DEBUG_LOGS:-0}"
review_log_path="$repo_root/review.log"
local_output_path="$repo_root/$local_output_file"
local_error_path="$repo_root/$local_error_file"
local_raw_jsonl_path="$repo_root/.request-review.events.jsonl"

use_existing_commit_flag="${REQUEST_REVIEW_USE_EXISTING_COMMIT:-0}"
existing_commit_sha_ref="${REQUEST_REVIEW_EXISTING_COMMIT_SHA:-HEAD}"
if [[ -n "$cli_use_existing_commit_flag" ]]; then
  use_existing_commit_flag="$cli_use_existing_commit_flag"
fi
if [[ -n "$cli_existing_commit_sha_ref" ]]; then
  existing_commit_sha_ref="$cli_existing_commit_sha_ref"
fi
remote_pr_number=""
remote_pr_state=""
remote_review_started_at=""
remote_branch_sha=""

lock_root="${HOME}/.codex/tmp"
clear_review_result
cd "$repo_root"
branch_name="$(git rev-parse --abbrev-ref HEAD)"

integration_branches_raw="${REQUEST_REVIEW_INTEGRATION_BRANCHES:-main master staging prod production}"
for protected_branch in $integration_branches_raw; do
  if [[ "$branch_name" == "$protected_branch" ]]; then
    echo "request-review: refusing to run on protected integration branch '$branch_name'" >&2
    echo "request-review: switch to an issue/feature branch before requesting review" >&2
    exit 2
  fi
done

if [[ "$review_mode" == "remote" ]]; then
  remote_pr_number="$(gh pr view --json number --jq '.number' 2>/dev/null || true)"
  if [[ -n "$remote_pr_number" ]]; then
    remote_pr_state="$(gh pr view --json state --jq '.state' 2>/dev/null || true)"
  fi
  remote_branch_sha="$(git ls-remote --heads origin "refs/heads/$branch_name" 2>/dev/null | awk 'NR==1 {print $1}')"
fi

if [[ "$use_existing_commit_flag" != "0" ]]; then
  review_sha="$(git rev-parse --verify "${existing_commit_sha_ref}^{commit}" 2>/dev/null || true)"
  if [[ -z "$review_sha" ]]; then
    echo "request-review: REQUEST_REVIEW_EXISTING_COMMIT_SHA is not a valid commit: $existing_commit_sha_ref" >&2
    exit 2
  fi
else
  git add -A
  if git diff --cached --quiet; then
    if [[ "$review_mode" == "remote" && -n "$remote_pr_number" && "$remote_pr_state" == "OPEN" ]]; then
      review_sha="$(git rev-parse --verify HEAD)"
      if [[ -n "$remote_branch_sha" && "$remote_branch_sha" == "$review_sha" ]]; then
        use_existing_commit_flag="1"
      fi
    else
      echo "request-review: no changes to commit; refusing to review an old commit" >&2
      exit 2
    fi
  else
    git commit -m "$commit_message"
    review_sha="$(git rev-parse --verify HEAD)"
  fi
fi

repo_name_for_lock="$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || basename "$repo_root")"
pr_number_for_lock="$remote_pr_number"

if [[ "$review_mode" == "remote" && -n "$pr_number_for_lock" ]]; then
  lock_scope="mode=remote|repo=${repo_name_for_lock}|pr=${pr_number_for_lock}"
else
  lock_scope="mode=${review_mode}|repo=${repo_name_for_lock}|branch=${branch_name}"
fi

lock_hash="$(python3 - <<'PY' "$lock_scope"
import hashlib
import sys
print(hashlib.sha256(sys.argv[1].encode("utf-8")).hexdigest()[:20])
PY
)"

lock_dir="${lock_root}/request-review.lock.${lock_hash}"
mkdir -p "$lock_root"
if ! mkdir "$lock_dir" 2>/dev/null; then
  echo "request-review: another request-review run is active for scope [$lock_scope]" >&2
  echo "request-review: lock path: $lock_dir" >&2
  exit 1
fi
printf 'pid=%s\nstarted=%s\nscope=%s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$lock_scope" >"$lock_dir/owner"
trap 'rm -f "$lock_dir/owner" 2>/dev/null || true; rmdir "$lock_dir" 2>/dev/null || true' EXIT

if [[ "$review_disable" != "0" ]]; then
  if [[ "$review_mode" == "remote" && "$use_existing_commit_flag" == "0" ]]; then
    git push -u origin HEAD
  fi
  persist_review_result "all clear!"
  emit_result "all clear!"
  exit 0
fi

if [[ "$review_mode" == "remote" ]]; then
  require_cmd gh
  require_cmd jq

  if [[ "$use_existing_commit_flag" == "0" ]]; then
    git push -u origin HEAD
  fi

  pr_number="$(gh pr view --json number,state --jq '.number' 2>/dev/null || true)"
  pr_state="$(gh pr view --json number,state --jq '.state' 2>/dev/null || true)"
  if [[ -z "$pr_number" ]]; then
    emit_result "request-review (remote): no PR found for branch '$branch_name'. Open a PR first."
    exit 1
  fi
  if [[ "$pr_state" != "OPEN" ]]; then
    emit_result "request-review (remote): PR #$pr_number is not OPEN (state: $pr_state)."
    exit 1
  fi

  repo_name="$(gh repo view --json nameWithOwner --jq '.nameWithOwner')"

  remote_review_started_at="$(gh api --method POST "repos/$repo_name/issues/$pr_number/comments" -f body="$trigger_comment" --jq '.created_at' 2>/dev/null || true)"
  if [[ -z "$remote_review_started_at" ]]; then
    emit_result "request-review (remote): failed to post trigger comment '$trigger_comment' on PR #$pr_number"
    exit 1
  fi
  commit_timestamp=""
  for _ in $(seq 1 30); do
    commit_timestamp="$(gh api "repos/$repo_name/pulls/$pr_number/commits" --jq '.[] | select(.sha=="'"$review_sha"'") | .commit.committer.date' || true)"
    if [[ -n "$commit_timestamp" ]]; then
      break
    fi
    sleep 2
  done

  if [[ -z "$commit_timestamp" ]]; then
    if [[ "$use_existing_commit_flag" != "0" ]]; then
      emit_result "request-review (remote): commit $review_sha is not present on PR #$pr_number. If needed, disable REQUEST_REVIEW_USE_EXISTING_COMMIT and rerun so this script can push."
    else
      emit_result "request-review (remote): commit $review_sha is not present on PR #$pr_number yet."
    fi
    exit 1
  fi

  eyes_announced=0
  while true; do
    inline_json="$(gh api "repos/$repo_name/pulls/$pr_number/comments?since=$commit_timestamp" --paginate \
      --jq '[.[] | select(.user.login=="'"$bot_login"'" and (.created_at >= "'"$remote_review_started_at"'") and (.commit_id=="'"$review_sha"'" or .original_commit_id=="'"$review_sha"'")) | {id,created_at,html_url,path,line,body}]')"

    inline_count="$(jq 'length' <<<"$inline_json")"
    if [[ "$inline_count" -gt 0 ]]; then
      result_header="request-review (remote): $inline_count inline comment(s) from $bot_login on PR #$pr_number for commit $review_sha"
      result_body="$(jq -r '.[] | "- \(.html_url)\n  File: \(.path // "unknown"):\(.line // 0)\n  Comment: \(.body)\n"' <<<"$inline_json")"
      persist_review_result "${result_header}"$'\n\n'"${result_body}"
      emit_result "${result_header}"$'\n\n'"${result_body}"
      exit 0
    fi

    reactions_json="$(gh api "repos/$repo_name/issues/$pr_number/reactions" -H 'Accept: application/vnd.github+json' --paginate \
      --jq '[.[] | select(.user.login=="'"$bot_login"'" and (.created_at >= "'"$remote_review_started_at"'")) | {content,created_at}]')"

    eyes_reaction="$(jq 'any(.[]; .content=="eyes")' <<<"$reactions_json")"
    if [[ "$eyes_reaction" == "true" && "$eyes_announced" -eq 0 ]]; then
      echo "request-review (remote): 👀 from $bot_login detected on PR #$pr_number; review is in progress, waiting for final result..."
      eyes_announced=1
    fi

    thumbs_up="$(jq 'any(.[]; .content=="+1")' <<<"$reactions_json")"
    if [[ "$thumbs_up" == "true" ]]; then
      persist_review_result "request-review (remote): 👍 from $bot_login on PR #$pr_number after commit $review_sha"
      emit_result "request-review (remote): 👍 from $bot_login on PR #$pr_number after commit $review_sha"
      exit 0
    fi

    sleep "$poll_interval_seconds"
  done
fi

if [[ "$review_mode" != "local" ]]; then
  echo "request-review: unsupported REQUEST_REVIEW_MODE='$review_mode' (expected 'local' or 'remote')" >&2
  exit 2
fi

require_cmd docker

local_tmp_output_path="$repo_root/.request-review.output.tmp"

config_file="${HOME}/.codex/config.toml"
if [[ ! -f "$config_file" ]]; then
  emit_result "request-review (local): missing config file: $config_file"
  exit 1
fi
if ! rg -q "^\[profiles\.${local_profile}\]$" "$config_file"; then
  emit_result "request-review (local): profile '$local_profile' not found in $config_file"
  exit 1
fi

shared_builder="${HOME}/.codex/scripts/build-codex-agent-image"
if [[ ! -x "$shared_builder" ]]; then
  emit_result "request-review (local): missing shared Docker builder: $shared_builder"
  exit 1
fi

local_image_tag="${REQUEST_REVIEW_IMAGE:-${COMMAND_PARSER_IMAGE:-command-parser:0.110.0}}"
host_codex_home="${CODEX_HOME:-$HOME/.codex}"
docker_home="/tmp/request-review-home"
docker_codex_home="/codex-home"

if ! docker image inspect "$local_image_tag" >/dev/null 2>&1; then
  CODEX_AGENT_IMAGE="$local_image_tag" \
  CODEX_AGENT_CODEX_VERSION="${REQUEST_REVIEW_CODEX_VERSION:-0.110.0}" \
    "$shared_builder" >/dev/null
fi

cmd=(
  docker run --rm -i
  -u "$(id -u):$(id -g)"
  -e "HOME=$docker_home"
  -e "CODEX_HOME=$docker_codex_home"
  -e "CODEX_NO_COLOR=1"
  -v "$host_codex_home:$docker_codex_home:rw"
  -v "$repo_root:/workspace:rw"
  --workdir /workspace
  "$local_image_tag"
  codex exec
  --skip-git-repo-check
  --json
  -C /workspace
  -s read-only
  -p "$local_profile"
  review
  --commit "$review_sha"
  --title "$commit_message"
)

if "${cmd[@]}" >"$local_raw_jsonl_path" 2>"$local_error_path"; then
  review_exit=0
else
  review_exit=$?
fi

extract_local_review_message "$local_raw_jsonl_path" "$local_tmp_output_path"

if [[ ! -s "$local_tmp_output_path" ]]; then
  emit_result "request-review (local): missing review output at $local_output_path (check $local_error_path)"
  exit 1
fi

local_review_message="$(cat "$local_tmp_output_path")"
rm -f "$local_tmp_output_path"

if [[ "$review_exit" -ne 0 ]]; then
  emit_result "$local_review_message"
  exit "$review_exit"
fi

persist_review_result "$local_review_message"
emit_result "$local_review_message"

if [[ "$local_keep_debug_logs" == "0" ]]; then
  rm -f "$local_raw_jsonl_path"
fi

exit 0
