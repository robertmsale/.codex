#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
resource_dir="$script_dir/../resources"
robdex="$HOME/.codex/skills/robdex-orchestrator/scripts/robdex"

role="worker"
if [[ -n "${CODEX_THREAD_ID:-}" ]] && [[ -x "$robdex" ]]; then
  if whoami_out="$("$robdex" whoami 2>/dev/null)"; then
    if printf '%s\n' "$whoami_out" | grep -qx 'role=orchestrator'; then
      role="orchestrator"
    fi
  fi
fi

cat "$resource_dir/$role.md"
